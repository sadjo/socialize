# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

# Version affichée dans l'interface ; l'image de production reçoit le tag de version (v0.X.Y).
APP_VERSION=dev

# Instance réservée aux comptes (temporaire ; 0 pour l'ouvrir au public) : accueil des visiteurs réduit au formulaire
# de connexion, fils publics (/local, /federe) et inscription fermés aux visiteurs, liens masqués.
HOME_LOGIN_ONLY=1

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/messenger ###
# File d'attente stockée dans la base de données : aucun service supplémentaire.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> doctrine/doctrine-bundle ###
# SQLite par défaut ; le conteneur utilise sqlite:////data/socialize.db.
# MySQL / MariaDB : précisez toujours serverVersion.
# DATABASE_URL="mysql://socialize:!ChangeMe!@127.0.0.1:3306/socialize?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/app_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###

###> socialize ###
# Dossier de stockage des médias (originaux et dérivés).
STORAGE_DIR="%kernel.project_dir%/var/media"
# Proxies de confiance (reverse proxy devant le conteneur).
TRUSTED_PROXIES=
# Qui peut créer un compte : open, invite (sur invitation) ou closed. Le premier compte est toujours accepté.
REGISTRATION=invite
# Clés étrangères SQLite (ON DELETE CASCADE). Désactivées automatiquement pendant les migrations.
SQLITE_FOREIGN_KEYS=1
# Autorise la fédération avec des adresses du réseau privé (tests locaux uniquement).
FEDERATION_ALLOW_PRIVATE_NETWORKS=0
###< socialize ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###
