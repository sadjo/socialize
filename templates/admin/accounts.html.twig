{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}Comptes · Administration · Socialize{% endblock %}

{% block content %}
<div class="page-narrow admin">
    <div class="page-h"><div class="grow"><h1>Administration{{ ui.help('administration', 'comptes', 'les comptes') }}</h1><p>Créez un compte directement, même lorsque les inscriptions sont fermées, puis transmettez ses identifiants à la personne. Seuls les comptes autorisés peuvent publier ou importer leur archive Instagram.</p></div></div>
    {{ include('admin/_tabs.html.twig', {current: 'accounts'}) }}

    <section class="card">
        <h2>Nouveau compte</h2>
        {{ form_start(form, {attr: {class: 'form'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.email) }}
            {{ form_row(form.username) }}
            {{ form_row(form.displayName) }}
            {{ form_row(form.password.first) }}
            {{ form_row(form.password.second) }}
            <div class="form-group" data-controller="requires">
                <label class="chk">{{ form_widget(form.publisher, {attr: {'data-requires-target': 'source', 'data-action': 'requires#update'}}) }}<span>{{ form.publisher.vars.label }}<br><small>{{ form.publisher.vars.help }}</small></span></label>
                <label class="chk">{{ form_widget(form.instagramImport, {attr: {'data-requires-target': 'dependent'}}) }}<span>{{ form.instagramImport.vars.label }}<br><small>{{ form.instagramImport.vars.help }}</small></span></label>
                {{ form_errors(form.instagramImport) }}
            </div>
            <button class="btn pri">{{ ui.icon('plus', 'xs') }}Créer le compte</button>
        {{ form_end(form) }}
    </section>

    <section class="card">
        <h2>Comptes ({{ users|length }})</h2>
        <div class="tbl-wrap">
        <table class="accounts">
            <thead><tr><th>Compte</th><th>Droits</th></tr></thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>
                        <a class="lnk" href="{{ path('app_profile', {username: user.account.username}) }}">@{{ user.account.username }}</a>{% if user.isAdmin() %} <span class="chip">Administrateur</span>{% endif %}
                        <span class="acct-meta small">{{ user.email }} · créé le <time datetime="{{ user.createdAt|date('c') }}">{{ user.createdAt|format_date('short', locale: 'fr') }}</time></span>
                        <a class="btn sm ghost acct-password" href="{{ path('admin_account_password', {id: user.id}) }}" aria-label="Changer le mot de passe de @{{ user.account.username }}">{{ ui.icon('key', 'xs') }}Mot de passe</a>
                        <a class="btn sm ghost acct-password" href="{{ path('admin_account_images', {id: user.account.id}) }}" aria-label="Changer la photo de @{{ user.account.username }}">{{ ui.icon('image', 'xs') }}Photo</a>
                        {% if user != app.user %}
                            <form method="post" action="{{ path('admin_account_delete', {id: user.id}) }}" class="acct-delete" data-turbo-confirm="Supprimer le compte @{{ user.account.username }} ? Ses publications, ses stories et ses fichiers sont effacés, et ses abonnés du fédivers prévenus. Cette action est définitive.">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-account-' ~ user.id) }}">
                                <button class="btn sm ghost danger" aria-label="Supprimer le compte @{{ user.account.username }}">{{ ui.icon('trash', 'xs') }}Supprimer</button>
                            </form>
                        {% endif %}
                    </td>
                    <td>
                        <ul class="rights">
                        {% for right in rights %}
                            <li>
                                <span>{{ right.label }}</span>
                                {% if user.isAdmin() %}
                                    <span class="small">Toujours</span>
                                {% elseif right.value == 'import-instagram' and not user.canPublish() %}
                                    <span class="small" title="L’import crée des publications : accordez d’abord la publication.">Nécessite la publication</span>
                                {% else %}
                                    <form method="post" action="{{ path('admin_account_right', {id: user.id, right: right.value}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('right-' ~ user.id) }}">
                                        {% if user.isGranted(right) %}
                                            <button class="btn sm done" name="allow" value="0" title="{{ right.label }} : retirer le droit à @{{ user.account.username }}">Autorisé · Retirer</button>
                                        {% else %}
                                            <button class="btn sm pri" name="allow" value="1" title="{{ right.label }} : autoriser @{{ user.account.username }}">Autoriser</button>
                                        {% endif %}
                                    </form>
                                {% endif %}
                            </li>
                        {% endfor %}
                        </ul>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
    </section>

    {% if mastodon_users is not empty %}
        {# Personnes connectées avec leur compte Mastodon : elles publient sur leur serveur ; seul l'import Instagram
           vers leur compte se permet ici. #}
        <section class="card">
            <h2>Comptes Mastodon ({{ mastodon_users|length }})</h2>
            <p class="small">Personnes connectées avec leur compte Mastodon. Elles publient sur leur serveur ; l’import Instagram envoie leurs publications sur leur compte Mastodon, sans copie ici.</p>
            <div class="tbl-wrap">
            <table class="accounts">
                <thead><tr><th>Compte</th><th>Droits</th></tr></thead>
                <tbody>
                {% for mastodon_user in mastodon_users %}
                    {% set acct = mastodon_user.account.acct %}
                    <tr>
                        <td>
                            <a class="lnk" href="{{ path('app_profile', {username: acct}) }}">@{{ acct }}</a>{% if not mastodon_user.tokenEncrypted %} <span class="chip">Déconnecté</span>{% endif %}
                            <span class="acct-meta small">dernière connexion le <time datetime="{{ mastodon_user.lastLoginAt|date('c') }}">{{ mastodon_user.lastLoginAt|format_date('short', locale: 'fr') }}</time></span>
                            <a class="btn sm ghost acct-password" href="{{ path('admin_account_images', {id: mastodon_user.account.id}) }}" aria-label="Changer la photo de @{{ acct }}">{{ ui.icon('image', 'xs') }}Photo</a>
                            <form method="post" action="{{ path('admin_mastodon_delete', {id: mastodon_user.id}) }}" class="acct-delete" data-turbo-confirm="Supprimer l’accès de @{{ acct }} ? La personne est déconnectée de Socialize ; elle pourra se reconnecter avec Mastodon.">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-mastodon-' ~ mastodon_user.id) }}">
                                <button class="btn sm ghost danger" aria-label="Supprimer l’accès de @{{ acct }}">{{ ui.icon('trash', 'xs') }}Supprimer</button>
                            </form>
                        </td>
                        <td>
                            <ul class="rights">
                                <li>
                                    <span>Import Instagram</span>
                                    <form method="post" action="{{ path('admin_mastodon_import', {id: mastodon_user.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('mastodon-right-' ~ mastodon_user.id) }}">
                                        {% if mastodon_user.canImportInstagram() %}
                                            <button class="btn sm done" name="allow" value="0" title="Import Instagram : retirer le droit à @{{ acct }}">Autorisé · Retirer</button>
                                        {% else %}
                                            <button class="btn sm pri" name="allow" value="1" title="Import Instagram : autoriser @{{ acct }}">Autoriser</button>
                                        {% endif %}
                                    </form>
                                </li>
                            </ul>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
        </section>
    {% endif %}
</div>
{% endblock %}
