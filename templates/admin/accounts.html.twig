{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}Comptes · Administration · Socialize{% endblock %}

{% block content %}
<div class="page-narrow admin">
    <div class="page-h"><div class="grow"><h1>Administration</h1><p>Créez un compte directement, même lorsque les inscriptions sont fermées, puis transmettez ses identifiants à la personne. Seuls les comptes autorisés peuvent publier ou importer leur archive Instagram.</p></div></div>
    {{ include('admin/_tabs.html.twig', {current: 'accounts'}) }}

    <section class="card">
        <h2>Nouveau compte</h2>
        {{ form_start(form, {attr: {class: 'form'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.email) }}
            {{ form_row(form.username) }}
            {{ form_row(form.displayName) }}
            {{ form_row(form.password.first) }}
            {{ form_row(form.password.second) }}
            {% for box in [form.publisher, form.instagramImport] %}
                <label class="chk">{{ form_widget(box) }}<span>{{ box.vars.label }}<br><small>{{ box.vars.help }}</small></span></label>
            {% endfor %}
            <button class="btn pri">{{ ui.icon('plus', 'xs') }}Créer le compte</button>
        {{ form_end(form) }}
    </section>

    <section class="card">
        <h2>Comptes ({{ users|length }})</h2>
        <table class="accounts">
            <thead><tr><th>Compte</th><th>Adresse e-mail</th><th>Créé</th>{% for right in rights %}<th>{{ right.label }}</th>{% endfor %}</tr></thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td><a class="lnk" href="{{ path('app_profile', {username: user.account.username}) }}">@{{ user.account.username }}</a>{% if user.isAdmin() %} <span class="chip">Administrateur</span>{% endif %}</td>
                    <td>{{ user.email }}</td>
                    <td><time datetime="{{ user.createdAt|date('c') }}">{{ user.createdAt|format_date('short', locale: 'fr') }}</time></td>
                    {% for right in rights %}
                        <td>
                            {% if user.isAdmin() %}
                                <span class="small">Toujours</span>
                            {% elseif right.value == 'import-instagram' and not user.canPublish() %}
                                <span class="small" title="L’import crée des publications : accordez d’abord la publication.">Nécessite la publication</span>
                            {% else %}
                                <form method="post" action="{{ path('admin_account_right', {id: user.id, right: right.value}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('right-' ~ user.id) }}">
                                    {% if user.isGranted(right) %}
                                        <button class="btn sm done" name="allow" value="0" title="{{ right.label }} : retirer le droit à @{{ user.account.username }}">Autorisé · Retirer</button>
                                    {% else %}
                                        <button class="btn sm pri" name="allow" value="1" title="{{ right.label }} : autoriser @{{ user.account.username }}">Autoriser</button>
                                    {% endif %}
                                </form>
                            {% endif %}
                        </td>
                    {% endfor %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </section>
</div>
{% endblock %}
