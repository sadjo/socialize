{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}Mot de passe de @{{ user.account.username }} · Administration · Socialize{% endblock %}

{% block content %}
<div class="page-narrow admin">
    <div class="page-h"><div class="grow"><h1>Administration</h1><p>Choisissez un nouveau mot de passe pour ce compte, puis transmettez-le à la personne.</p></div></div>
    {{ include('admin/_tabs.html.twig', {current: 'accounts'}) }}

    <section class="card">
        <h2>Mot de passe de @{{ user.account.username }}</h2>
        <p class="small">{{ user.email }}. Le compte sera déconnecté de ses appareils et devra se reconnecter avec le nouveau mot de passe.</p>
        {{ form_start(form, {attr: {class: 'form'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.password.first) }}
            {{ form_row(form.password.second) }}
            <div class="navbtns"><a class="btn ghost" href="{{ path('admin_accounts') }}">Annuler</a><button class="btn pri">{{ ui.icon('key', 'xs') }}Changer le mot de passe</button></div>
        {{ form_end(form) }}
    </section>
</div>
{% endblock %}
