{# Une page du fil, suivie du repère qui chargera la suivante (list/_more.html.twig). Variables : page, route,
   route_params en option. #}
{% for post in page.posts %}
    {{ include('post/_card.html.twig') }}
{% endfor %}
{{ include('list/_more.html.twig', {list_id: 'feed', next_url: page.next ? path(route, (route_params|default({}))|merge({apres: page.next.toString})) : null}) }}
