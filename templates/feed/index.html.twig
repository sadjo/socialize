{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}{{ tab == 'home' ? 'Accueil' : (tab == 'federated' ? 'Fil fédéré' : 'Fil local') }} · Socialize{% endblock %}

{% block content %}
<div class="home">
    <div class="feed-col">
        {% if tab == 'welcome' %}
            <section class="welcome">
                <h1>Partagez vos photos, chez vous</h1>
                <p class="small">Socialize est un réseau photo auto-hébergé. Voici les dernières publications publiques de {{ local_domain }}.</p>
                <div class="row">
                    <a class="btn pri" href="{{ path('app_login') }}">Se connecter</a>
                    {% if registration_open %}<a class="btn" href="{{ path('app_register') }}">Créer un compte</a>{% endif %}
                </div>
            </section>
        {% endif %}
        {% if tab == 'home' %}{{ include('feed/_stories_bar.html.twig') }}{% endif %}
        {{ include('feed/_tabs.html.twig') }}
        {% if tab in ['local', 'federated'] %}{{ include('search/_form.html.twig') }}{% endif %}
        <div class="feed">
            {% if page.empty %}
                <div class="empty">
                    {{ ui.icon('image') }}
                    {% if tab == 'home' %}
                        <b>Votre fil est vide pour l’instant</b>
                        <span>Publiez votre première photo, ou suivez des comptes depuis le fil local.</span>
                        <div class="row">{% if is_granted('ROLE_PUBLISHER') %}<a class="btn pri" href="{{ path('app_compose') }}">Publier</a>{% endif %}<a class="btn" href="{{ path('app_feed_local') }}">Voir le fil local</a></div>
                    {% elseif tab == 'federated' %}
                        <b>Aucune publication du fédivers pour l’instant</b>
                        <span>Suivez des comptes Mastodon ou Pixelfed : leurs publications publiques apparaîtront ici. Cherchez-les avec leur adresse, par exemple @nom@pixelfed.social.</span>
                    {% else %}
                        <b>Aucune publication publique pour l’instant</b>
                    {% endif %}
                </div>
            {% else %}
                {{ include('feed/_page.html.twig') }}
            {% endif %}
        </div>
    </div>
    {{ include('feed/_rail.html.twig') }}
</div>
{% endblock %}
