<div class="seg" role="tablist" aria-label="Fils">
    {% if app.user %}<a role="tab" class="{{ tab == 'home' ? 'on' }}" aria-selected="{{ tab == 'home' ? 'true' : 'false' }}" href="{{ path('app_home') }}">Publications</a>{% endif %}
    <a role="tab" class="{{ tab in ['local', 'welcome'] ? 'on' }}" aria-selected="{{ tab in ['local', 'welcome'] ? 'true' : 'false' }}" href="{{ path('app_feed_local') }}">Local</a>
    <a role="tab" class="{{ tab == 'federated' ? 'on' }}" aria-selected="{{ tab == 'federated' ? 'true' : 'false' }}" href="{{ path('app_feed_federated') }}">Fédéré</a>
</div>
