{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}Notifications · Socialize{% endblock %}

{% block content %}
{% set token = csrf_token('notifications') %}
{% set unread = notifications|filter(n => not n.read)|length %}
<div class="page-narrow">
    <div class="page-h">
        <div class="grow"><h1>Notifications</h1><p>Les « J’aime », commentaires et mentions reçus{{ is_granted('ROLE_ADMIN') ? ', et les nouveaux comptes de l’instance' }}. {{ unread ? unread ~ ' non lue' ~ (unread > 1 ? 's') ~ '.' : 'Tout est lu.' }}</p></div>
        {% if notifications is not empty %}
            <div class="row wrap">
                {% if unread %}
                    <form method="post" action="{{ path('app_notifications_read_all') }}">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <button class="btn sm">{{ ui.icon('check', 'xs') }}Tout marquer comme lu</button>
                    </form>
                {% endif %}
                <form method="post" action="{{ path('app_notifications_delete_all') }}" data-turbo-confirm="Supprimer toutes vos notifications ?">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <button class="btn sm ghost danger">{{ ui.icon('trash', 'xs') }}Tout supprimer</button>
                </form>
            </div>
        {% endif %}
    </div>

    {# Notifications sur l'appareil (Web Push) et choix de ce qu'on reçoit. #}
    <section class="card stack push-card" data-controller="push"
             data-push-key-value="{{ vapid_key }}" data-push-token-value="{{ csrf_token('push-device') }}"
             data-push-subscribe-url-value="{{ path('app_push_subscribe') }}" data-push-unsubscribe-url-value="{{ path('app_push_unsubscribe') }}">
        <div class="row wrap push-head">
            <span class="grow"><b>{{ ui.icon('bell', 'sm') }} Sur cet appareil</b><br><small data-push-target="status">Vérification…</small></span>
            <button type="button" class="btn sm pri" data-push-target="enable" data-action="push#enable" hidden>Activer les notifications</button>
            <button type="button" class="btn sm" data-push-target="disable" data-action="push#disable" hidden>Désactiver</button>
        </div>
        <details>
            <summary class="small">Ce que je reçois{% if devices %} · {{ devices }} appareil{{ devices > 1 ? 's' }} abonné{{ devices > 1 ? 's' }}{% endif %}</summary>
            {{ form_start(preferences_form, {attr: {class: 'form'}}) }}
                {% for field in preferences_form.children|filter(f => f.vars.name != '_token') %}
                    <label class="chk">{{ form_widget(field) }}<span>{{ field.vars.label }}</span></label>
                {% endfor %}
                <div class="navbtns"><span></span><button class="btn sm pri">Enregistrer</button></div>
            {{ form_end(preferences_form) }}
        </details>
    </section>

    {% if notifications is empty %}
        <section class="card empty-notifs">{{ ui.icon('bell') }}<p>Aucune notification. Les « J’aime » et commentaires sur vos publications apparaîtront ici.</p></section>
    {% else %}
        <ul class="notifs">
            {% for n in notifications %}
                {% set who = n.actor %}
                {% set cover = n.post ? n.post.media|first : null %}
                <li class="notif{{ n.read ? '' : ' unread' }}" id="notification-{{ n.id }}">
                    {# Toute la ligne ouvre la publication et marque la notification comme lue. #}
                    <form method="post" action="{{ path('app_notification_open', {id: n.id}) }}" class="notif-open">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <button>
                            <span class="notif-av">{{ ui.avatar(who, 44) }}<span class="notif-kind {{ n.type.value }}">{{ ui.icon({like: 'heart', comment: 'comment', mention: 'at', signup: 'user'}[n.type.value], 'xs') }}</span></span>
                            <span class="notif-text">
                                <span><b>{{ who.displayName }}</b>{% if not who.local %} <small>@{{ who.domain }}</small>{% endif %}
                                {%- if n.type.value == 'signup' %} {{ who.local ? 'a créé son compte' : 's’est connecté avec son compte Mastodon' }} (@{{ who.acct }}). Accordez-lui ses droits dans l’administration.
                                {%- elseif n.type.value == 'mention' %} vous a mentionné dans sa publication{% if n.post.caption %} : « {{ n.post.caption|length > 120 ? n.post.caption|slice(0, 120) ~ '…' : n.post.caption }} »{% else %}.{% endif %}
                                {%- elseif n.type.value == 'like' %} a aimé votre publication.{% else %} a commenté votre publication{% if n.comment %} : « {{ n.comment.content|length > 120 ? n.comment.content|slice(0, 120) ~ '…' : n.comment.content }} »{% else %}.{% endif %}{% endif %}</span>
                                <small><time datetime="{{ n.createdAt|date('c') }}">{{ n.createdAt|ago }}</time>{% if not n.read %} · <span class="notif-new">nouvelle</span>{% endif %}</small>
                            </span>
                            {% if cover and cover.ready and media_url(cover, 'thumb') %}<img class="notif-th" src="{{ media_url(cover, 'thumb') }}" alt="" loading="lazy">{% endif %}
                        </button>
                    </form>
                    <div class="notif-acts">
                        <form method="post" action="{{ path('app_notification_toggle', {id: n.id}) }}">
                            <input type="hidden" name="_token" value="{{ token }}">
                            <button class="ib" aria-label="{{ n.read ? 'Marquer comme non lue' : 'Marquer comme lue' }}" title="{{ n.read ? 'Marquer comme non lue' : 'Marquer comme lue' }}">{{ ui.icon(n.read ? 'eye' : 'check', 'sm') }}</button>
                        </form>
                        <form method="post" action="{{ path('app_notification_delete', {id: n.id}) }}">
                            <input type="hidden" name="_token" value="{{ token }}">
                            <button class="ib" aria-label="Supprimer la notification" title="Supprimer">{{ ui.icon('x', 'sm') }}</button>
                        </form>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
{% endblock %}
