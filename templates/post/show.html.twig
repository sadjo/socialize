{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% set author = post.account %}

{% block title %}{{ author.displayName }} : {{ post.caption ? (post.caption|length > 60 ? post.caption|slice(0, 60) ~ '…' : post.caption) : 'Publication' }} · Socialize{% endblock %}

{% block content %}
<div class="pd" style="max-height:none;margin:0 auto;animation:none" data-controller="like" id="post-{{ post.publicId }}">
    <div class="pd-media">
        {% if post.cover and post.cover.ready %}<div class="glow" style="background-image:url({{ media_url(post.cover, 'thumb') }})"></div>{% endif %}
        {{ include('post/_media.html.twig') }}
    </div>
    <div class="pd-side">
        <header class="ph">
            <a href="{{ path('app_profile', {username: author.acct}) }}">{{ ui.avatar(author, 36) }}</a>
            <div class="pmeta">
                <div class="pname"><a href="{{ path('app_profile', {username: author.acct}) }}"><b>{{ author.username }}</b></a>
                    {% if not author.local %}<span class="fed">{{ ui.icon('globe', 'xs') }}{{ author.domain }}</span>{% endif %}
                    {% if post.archived %}<span class="chip imp" title="Visible uniquement par vous, dans vos archives">{{ ui.icon('album', 'xs') }}Archivée</span>{% endif %}
                    <span class="chip imp" title="{{ post.visibility.description }}">{{ ui.icon(post.visibility.value == 'public' ? 'globe' : 'lock', 'xs') }}{{ post.visibility.label }}</span></div>
                {% if post.location %}<div class="psub">{{ ui.icon('pin', 'xs') }} {{ post.location }}</div>{% endif %}
            {% if post.music %}{{ include('post/_music_credit.html.twig', {music: post.music}) }}{% endif %}
            </div>
            {{ include('post/_menu.html.twig') }}
        </header>

        <div class="cmts" id="commentaires">
            {% if post.caption %}
                <div class="cmt">{{ ui.avatar(author, 32) }}<div class="t"><b>{{ author.username }}</b> {{ post.caption|rich_text(post.isImported()) }}<small><time datetime="{{ post.publishedAt|date('c') }}">{{ post.publishedAt|ago }}</time></small></div></div>
            {% endif %}
            <div class="cmts-list" id="post-{{ post.publicId }}-comments">
                {% for comment in comments %}{{ include('comment/_comment.html.twig') }}{% endfor %}
            </div>
            {% if not comments and not post.caption %}<p class="small" id="post-{{ post.publicId }}-no-comments">Aucun commentaire pour l’instant.</p>{% endif %}
        </div>

        {{ include('post/_actions.html.twig') }}
        <div class="pbody"><div class="ago"><time datetime="{{ post.publishedAt|date('c') }}">{{ post.publishedAt|ago }}</time>{% if post.updatedAt %} · modifié {{ post.updatedAt|ago }}{% endif %}{% if post.isImported() and post.originalCreatedAt %} · {{ ui.icon('download', 'xs') }} publié à l’origine sur Instagram le {{ post.originalCreatedAt|format_date('long', locale: 'fr') }}{% endif %}{% if post.url and not author.local %} · <a class="lnk" href="{{ post.url }}" target="_blank" rel="noopener nofollow">voir sur {{ author.domain }}</a>{% endif %}</div></div>

        {% if app.user %}
            {{ include('comment/_form.html.twig') }}
        {% else %}
            <div class="addc"><a class="lnk" href="{{ login_url ?? path('app_login') }}">Connectez-vous pour commenter</a></div>
        {% endif %}

    </div>
</div>
{% endblock %}
