{# Carte d'une publication dans un fil. Variables : post, liked #}
{% import '_macros.html.twig' as ui %}
{% set author = post.account %}
<article class="post" id="post-{{ post.publicId }}" data-controller="like">
    <header class="ph">
        <a href="{{ path('app_profile', {username: author.acct}) }}" aria-label="Profil de {{ author.displayName }}">{{ ui.avatar(author, 36) }}</a>
        <div class="pmeta">
            <div class="pname"><a href="{{ path('app_profile', {username: author.acct}) }}"><b>{{ author.username }}</b></a>
                {% if not author.local %}<span class="fed" title="Compte fédéré">{{ ui.icon('globe', 'xs') }}{{ author.domain }}</span>{% endif %}
                {% if post.archived %}<span class="chip imp" title="Visible uniquement par vous, dans vos archives">{{ ui.icon('album', 'xs') }}Archivée</span>{% endif %}
                {% if post.visibility.value != 'public' %}{{ include('post/_visibility.html.twig') }}{% endif %}
            </div>
            {% if post.location %}<div class="psub">{{ ui.icon('pin', 'xs') }} {{ post.location }}</div>{% endif %}
            {% if post.music %}{{ include('post/_music_credit.html.twig', {music: post.music}) }}{% endif %}
        </div>
        {{ include('post/_menu.html.twig', {in_feed: true}) }}
    </header>
    {{ include('post/_media.html.twig') }}
    {{ include('post/_actions.html.twig') }}
    <div class="pbody">
        {% if post.caption %}<div><b>{{ author.username }}</b> {{ post.caption|rich_text(post.isImported()) }}</div>{% endif %}
        {% set preview = post.commentsCount ? recent_comments(post, 2) : [] %}
        {% if post.commentsCount > preview|length %}<a class="meta" href="{{ path('app_post_show', {id: post.publicId, _fragment: 'commentaires'}) }}">Voir les {{ post.commentsCount }} commentaires</a>{% endif %}
        <div class="cprev" id="post-{{ post.publicId }}-comments">
            {% for comment in preview %}{{ include('comment/_comment.html.twig', {compact: true}) }}{% endfor %}
        </div>
        <a class="ago" href="{{ path('app_post_show', {id: post.publicId}) }}"><time datetime="{{ post.publishedAt|date('c') }}">{{ post.publishedAt|ago }}</time>{% if not author.local %} · via @{{ author.acct }}{% endif %}</a>
        {% if post.isImported() and post.originalCreatedAt %}<div class="meta">{{ ui.icon('download', 'xs') }} Publié à l’origine sur Instagram le {{ post.originalCreatedAt|format_date('long', locale: 'fr') }}</div>{% endif %}
    </div>
    {% if app.user %}{{ include('comment/_form.html.twig') }}{% endif %}
</article>
