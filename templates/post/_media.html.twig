{# Médias d'une publication : carrousel, visionneuse (clic), vidéo, musique, avertissement de contenu. Variables : post
   Toutes les publications ont le même cadre 4:5, que le média couvre entièrement (la visionneuse le montre en
   entier). Les points du carrousel sont sous le cadre. #}
{% import '_macros.html.twig' as ui %}
{% set count = post.media|length %}
{% set music = post.music %}
<div class="media" data-controller="carousel lightbox{{ post.sensitive ? ' reveal' }}{{ music ? ' music' }}" data-action="dblclick->like#doubleTap dblclick->lightbox#cancel" data-carousel-count-value="{{ count }}"
     {%- if music %} data-music data-music-start-value="{{ post.musicStart }}" data-music-excerpt-value="{{ constant('App\\Core\\Domain\\Music\\MusicChoice::EXCERPT') }}"{% endif %}>
    <div class="frame">
    <div class="track" data-carousel-target="track">
        {% for media in post.media %}
            {% set viewable = media.ready %}
            <div class="slide{{ media.video ? ' vid' }}"
                 {%- if viewable %} data-lightbox-target="item" data-action="click->lightbox#open" data-lightbox-type="{{ media.video ? 'video' : 'image' }}"
                 data-lightbox-src="{{ media_url(media, media.video ? 'video' : 'large') }}"{% if media.video and media_url(media, 'poster') %} data-lightbox-poster="{{ media_url(media, 'poster') }}"{% endif %}
                 {%- if media.width and media.height %} data-lightbox-width="{{ media.width }}" data-lightbox-height="{{ media.height }}"{% endif %}
                 data-lightbox-alt="{{ media.altText ?? ((media.video ? 'Vidéo ' : 'Photo ') ~ loop.index ~ ' sur ' ~ count) }}"{% endif %}>
                {% if media.ready and media.video %}
                    {# Sans affiche (vidéo d'une instance qui n'en fournit pas), le navigateur montre la première image. #}
                    {% set poster = media_url(media, 'poster') %}
                    <div class="player muted" data-controller="video">
                        <video playsinline muted loop preload="{{ poster ? 'none' : 'metadata' }}"{% if poster %} poster="{{ poster }}"{% endif %} data-video-target="video"
                               {% if media.altText %} aria-label="{{ media.altText }}"{% endif %}>
                            {# Copie convertie : toujours un MP4 (H.264), quel que soit l'original (MOV d'iPhone…). Vidéo distante : type laissé au navigateur. #}
                            <source src="{{ media_url(media, 'video') }}{{ poster ? '' : '#t=0.1' }}"{% if not media.isRemote() %} type="video/mp4"{% endif %}>
                        </video>
                        <button type="button" class="snd" data-video-target="sound" data-action="video#toggleSound" aria-label="Activer le son" aria-pressed="false">
                            {{- ui.icon('mute', 'off') }}{{ ui.icon('volume', 'on') -}}
                        </button>
                    </div>
                {% elseif media.ready %}
                    <img src="{{ media_url(media, 'large') }}" width="{{ media.width }}" height="{{ media.height }}"
                         alt="{{ media.altText ?? ('Photo ' ~ loop.index ~ ' sur ' ~ count) }}" loading="lazy" decoding="async" draggable="false">
                {% elseif media.status.value == 'failed' %}
                    <div class="processing">{{ ui.icon('flag') }}<br>Ce média n’a pas pu être préparé.<br>{{ media.failureReason }}</div>
                {% else %}
                    <div class="processing skel">{{ ui.icon('reel') }}<br>Vidéo en cours de préparation…</div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
    {% if music %}
        <audio class="post-music" preload="none" src="{{ music_url(music) }}" data-music-target="audio"></audio>
        <button type="button" class="snd music-snd" data-music-target="sound" data-action="music#toggleSound" aria-label="Écouter la musique" aria-pressed="false">
            {{- ui.icon('mute', 'off') }}{{ ui.icon('volume', 'on') -}}
        </button>
    {% endif %}
    {% if count > 1 %}
        <span class="cnt num" data-carousel-target="counter">1/{{ count }}</span>
        {# Pas de flèche vers l'arrière sur le premier média, ni vers l'avant sur le dernier (carousel_controller). #}
        <button type="button" class="nb prev" data-carousel-target="prev" data-action="carousel#prev" aria-label="Média précédent" hidden>{{ ui.icon('left', 'sm') }}</button>
        <button type="button" class="nb next" data-carousel-target="next" data-action="carousel#next" aria-label="Média suivant">{{ ui.icon('right', 'sm') }}</button>
    {% endif %}
    {% if post.sensitive %}
        <div class="cw-veil" data-reveal-target="veil">
            <div>{{ ui.icon('eye') }}<b>Contenu sensible</b><span>{{ post.contentWarning }}</span><br>
                <button type="button" class="btn sm" data-action="reveal#show">Afficher</button></div>
        </div>
    {% endif %}
    </div>
    {% if count > 1 %}
        {# Points cliquables : chacun mène au média correspondant. #}
        <div class="dots" role="group" aria-label="Médias de la publication">
            {%- for i in 1..count %}<button type="button" class="{{ loop.first ? 'on' }}" data-carousel-target="dot" data-action="carousel#show" data-carousel-index-param="{{ loop.index0 }}" aria-label="Média {{ i }} sur {{ count }}"{% if loop.first %} aria-current="true"{% endif %}><i></i></button>{% endfor -%}
        </div>
    {% endif %}
</div>
