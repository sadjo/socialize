{# Personnes qui ont aimé une publication. Variables : post, likers (list<Account>) #}
{% import '_macros.html.twig' as ui %}
<turbo-frame id="likers-frame-{{ post.publicId }}">
    {% if likers is empty %}
        <p class="meta">Personne pour l’instant.</p>
    {% else %}
        <ul class="likers-list">
            {% for who in likers %}
                <li>
                    <a href="{{ path('app_profile', {username: who.acct}) }}" data-turbo-frame="_top">
                        {{ ui.avatar(who, 40) }}
                        <span><b>{{ who.displayName }}</b><small>@{{ who.local ? who.username : who.acct }}</small></span>
                    </a>
                </li>
            {% endfor %}
        </ul>
        {% if post.likesCount > likers|length %}
            {# J'aime venus du fédivers sans compte connu ici, ou au-delà de la liste. #}
            <p class="meta">Et {{ post.likesCount - likers|length }} autre{{ post.likesCount - likers|length > 1 ? 's' }}.</p>
        {% endif %}
    {% endif %}
</turbo-frame>
