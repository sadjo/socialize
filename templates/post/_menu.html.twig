{# Menu « … » d'une publication. Variables : post, in_feed (lien vers la page de la publication) #}
{% import '_macros.html.twig' as ui %}
{% set me = app.user ? app.user.account : null %}
<details class="pmenu" data-controller="menu">
    <summary class="ib" aria-label="Plus d’options">{{ ui.icon('more') }}</summary>
    <div class="menu" role="menu">
        {% if in_feed|default(false) %}
            <a role="menuitem" href="{{ path('app_post_show', {id: post.publicId}) }}">{{ ui.icon('image', 'sm') }}Ouvrir la publication</a>
        {% endif %}
        {{ include('post/_share_button.html.twig', {class: '', label: true}) }}
        <button type="button" role="menuitem" data-controller="copy" data-copy-text-value="{{ url('app_post_show', {id: post.publicId}) }}" data-copy-toast-value="Lien copié !" data-action="copy#copy menu#close">{{ ui.icon('link', 'sm') }}Copier le lien</button>
        {% if not post.account.local and post.url %}
            <a role="menuitem" href="{{ post.url }}" target="_blank" rel="noopener nofollow">{{ ui.icon('globe', 'sm') }}Voir sur {{ post.account.domain }}</a>
        {% endif %}
        {% if post.ownedBy(me) %}
            {% set share_files = [] %}
            {% for media in post.media %}
                {% if media.ready %}
                    {% set share_files = share_files|merge([{url: path('app_post_share_file', {id: post.publicId, position: loop.index0}), name: 'socialize-' ~ post.publicId ~ '-' ~ loop.index ~ (media.video ? '.mp4' : '.jpg'), type: media.video ? 'video/mp4' : 'image/jpeg'}]) %}
                {% endif %}
            {% endfor %}
            {# Instagram connecté et publication jamais envoyée : envoi automatique, le partage manuel reste proposé. #}
            {% set can_send = can_send_to_instagram(post) %}
            {% if can_send %}{{ include('post/_instagram_send_form.html.twig', {menuitem: true}) }}{% endif %}
            {% if share_files is not empty %}{{ include('post/_share_instagram.html.twig', {files: share_files, caption: post.caption, label: true, manual: can_send}) }}{% endif %}
            {% if not post.isFederated() %}
                <a role="menuitem" href="{{ path('app_post_edit', {id: post.publicId}) }}">{{ ui.icon('sliders', 'sm') }}Modifier</a>
                <form method="post" action="{{ path(post.archived ? 'app_post_unarchive' : 'app_post_archive', {id: post.publicId}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('archive-' ~ post.publicId) }}">
                    <button role="menuitem">{{ ui.icon('album', 'sm') }}{{ post.archived ? 'Désarchiver' : 'Archiver' }}</button>
                </form>
            {% endif %}
            <form method="post" action="{{ path('app_post_delete', {id: post.publicId}) }}" data-turbo-confirm="Supprimer cette publication et ses médias ? Cette action est définitive.">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-' ~ post.publicId) }}">
                <button role="menuitem" class="danger">{{ ui.icon('trash', 'sm') }}Supprimer</button>
            </form>
        {% endif %}
    </div>
</details>
