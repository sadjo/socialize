{# Boutons et compteurs, remplacés par Turbo Stream après un like. Variables : post, liked #}
{% import '_macros.html.twig' as ui %}
{% set is_liked = liked[post.publicId] ?? false %}
<div id="post-{{ post.publicId }}-actions">
    <div class="acts">
        {% if app.user %}
            <form method="post" action="{{ path('app_post_like', {id: post.publicId}) }}" data-like-target="form">
                <input type="hidden" name="_token" value="{{ csrf_token('like-' ~ post.publicId) }}">
                <input type="hidden" name="source" value="" data-like-target="source">
                <button class="act{{ is_liked ? ' liked' }}" aria-pressed="{{ is_liked ? 'true' : 'false' }}" aria-label="{{ is_liked ? 'Je n’aime plus' : 'J’aime' }}">{{ ui.icon('heart') }}</button>
            </form>
        {% else %}
            <a class="act" href="{{ login_url ?? path('app_login') }}" aria-label="Connectez-vous pour aimer">{{ ui.icon('heart') }}</a>
        {% endif %}
        {% if app.user %}
            {# L'étiquette du champ de commentaire : un clic place le curseur dans le champ. #}
            <label class="act" for="post-{{ post.publicId }}-comment" aria-label="Commenter">{{ ui.icon('comment') }}</label>
        {% else %}
            <a class="act" href="{{ path('app_post_show', {id: post.publicId, _fragment: 'commentaires'}) }}" aria-label="Voir les commentaires">{{ ui.icon('comment') }}</a>
        {% endif %}
        {{ include('post/_share_button.html.twig', {class: 'act', label: false}) }}
        <span class="sp"></span>
    </div>
    <div class="pbody" style="padding-bottom:0">
        <div class="num">
            {%- if post.likesCount > 0 -%}
                {# Compteur cliquable : la liste des personnes est chargée à l'ouverture (turbo-frame paresseux). #}
                <button type="button" class="likes-count" popovertarget="likers-{{ post.publicId }}" aria-haspopup="dialog"><b>{{ post.likesCount|format_number(locale: 'fr') }} J’aime</b></button>
                <div id="likers-{{ post.publicId }}" class="likers" popover role="dialog" aria-label="Personnes qui aiment cette publication">
                    <div class="sheet">
                        <header><b>J’aime</b><button type="button" class="ib" popovertarget="likers-{{ post.publicId }}" popovertargetaction="hide" aria-label="Fermer">{{ ui.icon('x') }}</button></header>
                        <turbo-frame id="likers-frame-{{ post.publicId }}" src="{{ path('app_post_likers', {id: post.publicId}) }}" loading="lazy"><p class="meta">Chargement…</p></turbo-frame>
                    </div>
                </div>
            {%- else -%}
                <b>0 J’aime</b>
            {%- endif -%}{% if post.commentsCount %} <span class="meta">· {{ post.commentsCount }} commentaire{{ post.commentsCount > 1 ? 's' }}</span>{% endif %}</div>
    </div>
</div>
