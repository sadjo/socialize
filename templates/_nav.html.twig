{# Entrées de navigation, partagées par le menu de gauche (bureau) et la fenêtre « Menu » (mobile).
   Variables du layout : me, current_route, visitor_closed, home_login_only, login_url. #}
{% import '_macros.html.twig' as ui %}
    <a class="nav{{ current_route == 'app_home' ? ' on' }}" href="{{ path('app_home') }}"{% if current_route == 'app_home' %} aria-current="page"{% endif %}>{{ ui.icon('home') }}<span class="lbl">Accueil</span></a>
    {% if me or not home_login_only %}<a class="nav{{ current_route == 'app_feed_local' ? ' on' }}" href="{{ path('app_feed_local') }}"{% if current_route == 'app_feed_local' %} aria-current="page"{% endif %}>{{ ui.icon('compass') }}<span class="lbl">Local</span></a>{% endif %}
    {% if not visitor_closed %}<a class="nav{{ current_route == 'app_search' ? ' on' }}" href="{{ path('app_search') }}">{{ ui.icon('search') }}<span class="lbl">Rechercher</span></a>{% endif %}
    {% if me %}
        <a class="nav{{ current_route == 'app_compose' ? ' on' }}" href="{{ path('app_compose') }}">{{ ui.icon('plus') }}<span class="lbl">Créer</span></a>
        <a class="nav{{ current_route == 'app_profile' and account is defined and account.id == me.id ? ' on' }}" href="{{ path('app_profile', {username: me.username}) }}">{{ ui.icon('user') }}<span class="lbl">Profil</span></a>
        <div class="sep"></div>
        <a class="nav{{ (current_route ?? '') starts with 'app_import' ? ' on' }}" href="{{ path('app_import') }}">{{ ui.icon('download') }}<span class="lbl">Import Instagram</span></a>
        <a class="nav{{ current_route == 'app_settings' ? ' on' }}" href="{{ path('app_settings') }}">{{ ui.icon('sliders') }}<span class="lbl">Réglages</span></a>
        {% if app.user.isAdmin() %}<a class="nav{{ (current_route ?? '') starts with 'admin_' ? ' on' }}" href="{{ path('admin_invitations') }}">{{ ui.icon('shield') }}<span class="lbl">Administration</span></a>{% endif %}
    {% else %}
        <div class="sep"></div>
        <a class="nav{{ current_route == 'app_login' ? ' on' }}" href="{{ login_url }}">{{ ui.icon('login') }}<span class="lbl">Connexion</span></a>
        {% if me or not home_login_only %}<a class="nav{{ current_route == 'app_register' ? ' on' }}" href="{{ path('app_register') }}">{{ ui.icon('user') }}<span class="lbl">Créer un compte</span></a>{% endif %}
    {% endif %}
    <div class="grow"></div>
    <button class="nav" type="button" data-controller="theme" data-action="theme#toggle">{{ ui.icon('moon') }}<span class="lbl" data-theme-target="label">Changer de thème</span></button>
    {% if me %}
        <a class="nav" href="{{ path('app_logout') }}">{{ ui.icon('logout') }}<span class="lbl">Déconnexion</span></a>
    {% endif %}
    <p class="side-version" title="Version de Socialize">{{ app_version }}</p>
