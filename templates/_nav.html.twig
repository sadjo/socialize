{# Entrées de navigation, partagées par le menu de gauche (bureau) et la fenêtre « Menu » (mobile).
   Variables du layout : me, current_route, visitor_closed, home_login_only, login_url. #}
{% import '_macros.html.twig' as ui %}
    <a class="nav{{ current_route == 'app_home' ? ' on' }}" href="{{ path('app_home') }}"{% if current_route == 'app_home' %} aria-current="page"{% endif %}>{{ ui.icon('image') }}<span class="lbl">Publications</span></a>
    {% if me or not home_login_only %}<a class="nav{{ current_route == 'app_feed_local' ? ' on' }}" href="{{ path('app_feed_local') }}"{% if current_route == 'app_feed_local' %} aria-current="page"{% endif %}>{{ ui.icon('compass') }}<span class="lbl">Local</span></a>{% endif %}
    {% if not visitor_closed %}<a class="nav{{ current_route == 'app_search' ? ' on' }}" href="{{ path('app_search') }}">{{ ui.icon('search') }}<span class="lbl">Rechercher</span></a>{% endif %}
    {% if me %}
        {% if is_granted('ROLE_PUBLISHER') %}<button type="button" class="nav{{ current_route in ['app_compose', 'app_story_new'] ? ' on' }}" popovertarget="create-menu" aria-haspopup="dialog">{{ ui.icon('plus') }}<span class="lbl">Créer</span></button>
        {% elseif is_granted('ROLE_MASTODON') %}<a class="nav{{ current_route == 'app_mastodon_compose' ? ' on' }}" href="{{ path('app_mastodon_compose') }}">{{ ui.icon('plus') }}<span class="lbl">Publier</span></a>{% endif %}
        {% set mastodon = is_granted('ROLE_MASTODON') %}
        {% set unread = unread_notifications() %}
        <a class="nav notif-link{{ current_route == 'app_notifications' ? ' on' }}" href="{{ path('app_notifications') }}"{% if current_route == 'app_notifications' %} aria-current="page"{% endif %}>{{ ui.icon('bell') }}<span class="lbl">Notifications</span>{% if unread %}<span class="badge num" aria-label="{{ unread }} non lue{{ unread > 1 ? 's' }}">{{ unread > 99 ? '99+' : unread }}</span>{% endif %}</a>
        <a class="nav{{ current_route == 'app_profile' and account is defined and account.id == me.id ? ' on' }}" href="{{ path('app_profile', {username: me.acct}) }}">{{ ui.icon('user') }}<span class="lbl">Profil</span></a>
        <div class="sep"></div>
        {% if mastodon %}
            {# Compte Mastodon : il se règle sur son serveur ; seule l'apparence se choisit ici. #}
            <a class="nav{{ current_route in ['app_settings_appearance', 'app_settings_instagram'] or (current_route ?? '') starts with 'app_import' ? ' on' }}" href="{{ path('app_settings_appearance') }}">{{ ui.icon('moon') }}<span class="lbl">Apparence</span></a>
            {% if me.profileUrl %}<a class="nav" href="{{ me.profileUrl }}" target="_blank" rel="noopener">{{ ui.icon('sliders') }}<span class="lbl">Mon compte sur {{ me.domain }}</span></a>{% endif %}
        {% else %}
            <a class="nav{{ (current_route ?? '') starts with 'app_settings' or (current_route ?? '') starts with 'app_import' ? ' on' }}" href="{{ path('app_settings') }}">{{ ui.icon('sliders') }}<span class="lbl">Réglages</span></a>
        {% endif %}
        {% if app.user.isAdmin() %}<a class="nav{{ (current_route ?? '') starts with 'admin_' ? ' on' }}" href="{{ path('admin_accounts') }}">{{ ui.icon('shield') }}<span class="lbl">Administration</span></a>{% endif %}
    {% else %}
        <div class="sep"></div>
        <a class="nav{{ current_route == 'app_login' ? ' on' }}" href="{{ login_url }}">{{ ui.icon('login') }}<span class="lbl">Connexion</span></a>
        {% if me or not home_login_only %}<a class="nav{{ current_route == 'app_register' ? ' on' }}" href="{{ path('app_register') }}">{{ ui.icon('user') }}<span class="lbl">Créer un compte</span></a>{% endif %}
    {% endif %}
    <div class="grow"></div>
    {% if me %}
        <a class="nav" href="{{ path('app_logout') }}">{{ ui.icon('logout') }}<span class="lbl">Déconnexion</span></a>
    {% endif %}
    <a class="side-help{{ (current_route ?? '') starts with 'app_help' ? ' on' }}" href="{{ path('app_help') }}">Aide</a>
    <p class="side-version" title="Version de Socialize">{{ app_version }}</p>
