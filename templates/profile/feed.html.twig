{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}Publications de {{ account.displayName }} · Socialize{% endblock %}

{% block content %}
<div class="home">
    <div class="feed-col">
        <header class="pf-head">
            <a class="ib" href="{{ path('app_profile', {username: account.acct}) }}" aria-label="Retour au profil">{{ ui.icon('left') }}</a>
            <div><b>Publications</b><small>@{{ account.acct }}</small></div>
        </header>
        <div class="feed">
            {% if has_more_newer %}
                <div class="more"><a class="btn" href="{{ path('app_profile_feed', {username: account.acct, depuis: (newer|first).publicId, _fragment: 'post-' ~ (newer|first).publicId}) }}">Voir les publications plus récentes</a></div>
            {% endif %}
            {% for post in newer %}
                {{ include('post/_card.html.twig') }}
            {% endfor %}
            {{ include('post/_card.html.twig') }}
            {{ include('feed/_page.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
