{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}{{ account.displayName }} (@{{ account.username }}) · Socialize{% endblock %}

{% block content %}
<div class="prof">
    {% set cover = cover_url(account) %}
    {% if cover %}
        <div class="prof-cover"><img src="{{ cover }}" alt="Image de couverture de {{ account.displayName }}"></div>
    {% elseif is_owner and account.local %}
        <a class="prof-cover empty" href="{{ path('app_settings') }}">{{ ui.icon('image') }}Ajouter une image de couverture</a>
    {% endif %}
    <section class="prof-h">
        {% if story_group %}
            <a class="ring has-story{{ story_group.fullySeen ? ' seen' }}" href="{{ path('app_account_stories', {username: account.username}) }}" aria-label="Voir les stories de {{ account.displayName }}">{{ ui.avatar(account, 150) }}</a>
        {% else %}
            <span class="ring seen">{{ ui.avatar(account, 150) }}</span>
        {% endif %}
        {% if not app.user %}
            {# Profil public : nom d'affichage, nom d'utilisateur, adresse à copier, puis adresse dans le fédivers. #}
            <div class="prof-i prof-public">
                <div class="names">
                    <h1>{{ account.displayName }}</h1>
                    <p class="uname">{{ account.local ? account.username : account.acct }}</p>
                </div>
                {% set profile_url = account.local ? url('app_profile', {username: account.username}) : (account.profileUrl ?? url('app_profile', {username: account.acct})) %}
                <div><button type="button" class="btn sm" data-controller="copy" data-copy-text-value="{{ profile_url }}" data-copy-toast-value="Adresse copiée !" data-action="copy#copy">{{ ui.icon('copy', 'xs') }}Copier l’adresse</button></div>
                <span class="handle" title="Adresse dans le fédivers (Mastodon, Pixelfed…)">{{ ui.icon('globe', 'xs') }}{{ handle(account, local_domain) }}</span>
            </div>
            {# Sur mobile, sous la photo et les noms, sur toute la largeur. #}
            <div class="prof-more">
                {{ block('stats') }}
                {% if account.bio %}<div class="bio">{{ account.bio|rich_text }}</div>{% endif %}
            </div>
        {% else %}
            <div class="prof-i">
                <div class="row">
                    <h1>{{ account.local ? account.username : account.displayName }}</h1>
                    {% if is_owner and is_granted('ROLE_MASTODON') %}
                        {# Compte Mastodon : son profil se modifie sur son serveur. #}
                        {% if account.profileUrl %}<a class="btn sm" href="{{ account.profileUrl }}" target="_blank" rel="noopener">Modifier sur {{ account.domain }}</a>{% endif %}
                    {% elseif is_owner %}
                        <a class="btn sm" href="{{ path('app_settings') }}">Modifier le profil</a>
                    {% elseif app.user %}
                        {% if follow_pending %}
                            <form method="post" action="{{ path('app_profile_unfollow', {username: account.acct}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('follow-' ~ account.acct) }}">
                                <button class="btn sm done" title="En attente de l’accord de ce compte">Demande envoyée · Annuler</button>
                            </form>
                        {% elseif is_following %}
                            <form method="post" action="{{ path('app_profile_unfollow', {username: account.acct}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('follow-' ~ account.acct) }}">
                                <button class="btn sm done">Abonné · Ne plus suivre</button>
                            </form>
                        {% else %}
                            <form method="post" action="{{ path('app_profile_follow', {username: account.acct}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('follow-' ~ account.acct) }}">
                                <button class="btn sm pri">Suivre</button>
                            </form>
                        {% endif %}
                    {% else %}
                        <a class="btn sm pri" href="{{ login_url ?? path('app_login') }}">Suivre</a>
                    {% endif %}
                    <button type="button" class="btn sm" data-controller="copy" data-copy-text-value="{{ handle(account, local_domain) }}" data-copy-toast-value="Adresse copiée !" data-action="copy#copy">{{ ui.icon('copy', 'xs') }}Copier l’adresse</button>
                </div>
                {{ block('stats') }}
                <div class="bio"><b>{{ account.displayName }}</b>{% if account.bio %}<br>{{ account.bio|rich_text }}{% endif %}</div>
                <span class="handle">{{ ui.icon('globe', 'xs') }}{{ handle(account, local_domain) }}</span>
                {% if not account.local %}
                    <p class="small">Compte de <b>{{ account.domain }}</b>. Ses publications récentes sont récupérées ici ; l’historique complet reste sur son instance{% if account.profileUrl %} · <a class="lnk" href="{{ account.profileUrl }}" target="_blank" rel="noopener nofollow">voir le profil sur son instance</a>{% endif %}.</p>
                {% endif %}
            </div>
        {% endif %}
    </section>

    {% set mastodon_owner = is_owner and is_granted('ROLE_MASTODON') %}
    {% if highlights is not empty or (is_owner and not mastodon_owner) %}
        <div class="hls" aria-label="Stories à la une">
            {% for highlight in highlights %}
                {% set cover = highlight_cover_url(highlight) %}
                <a class="hl" href="{{ path('app_highlight', {username: account.username, id: highlight.publicId}) }}">
                    <span class="c">{% if cover %}<img src="{{ cover }}" alt="">{% endif %}</span>{{ highlight.title }}
                </a>
            {% endfor %}
            {% if is_owner and not mastodon_owner %}
                <a class="hl" href="{{ path('app_story_manage') }}"><span class="c" style="display:grid;place-items:center">{{ ui.icon('plus') }}</span>Mes stories</a>
            {% endif %}
        </div>
    {% endif %}

    {% if pending_posts is not empty %}{{ include('profile/_pending.html.twig') }}{% endif %}
    {% if mastodon_owner %}{{ include('profile/_mastodon_publications.html.twig', {publications: mastodon_publications()}) }}{% endif %}

    <div>
        {{ include('profile/_tabs.html.twig', {current: tab}) }}
        {% if page.empty %}
            <div class="empty">
                {{ ui.icon(tab == 'texts' ? 'list' : 'image') }}
                {% if is_owner %}
                    <b>{{ tab == 'texts' ? 'Aucune publication texte pour l’instant' : 'Aucune photo ni vidéo pour l’instant' }}</b>
                    {% if is_granted('ROLE_PUBLISHER') %}<a class="btn pri" href="{{ path('app_compose', tab == 'texts' ? {type: 'texte'} : {}) }}">{{ tab == 'texts' ? 'Écrire une première publication' : 'Publier une première photo' }}</a>{% endif %}
                {% else %}
                    <b>{{ tab == 'texts' ? 'Aucune publication texte visible' : 'Aucune photo ni vidéo visible' }}</b>
                {% endif %}
            </div>
        {% elseif tab == 'texts' %}
            <div class="ptexts" data-controller="infinite-list">{{ include('profile/_texts_page.html.twig') }}</div>
        {% else %}
            <div class="grid3" data-controller="infinite-list">{{ include('profile/_grid_page.html.twig') }}</div>
        {% endif %}
    </div>
</div>
{% endblock %}

{# Compteurs (liens vers les listes quand elles sont visibles), partagés par les deux en-têtes. #}
{% block stats %}
<div class="stats num">
    <span><b>{{ stats.posts|format_number(locale: 'fr') }}</b> publication{{ stats.posts > 1 ? 's' }}</span>
    {% if stats.remote|default(false) %}
        {# Compte du fédivers : nombres donnés par son instance (les listes d'ici ne connaissent que ses liens avec cette instance). #}
        <span><b>{{ stats.followers|format_number(locale: 'fr') }}</b> abonné{{ stats.followers > 1 ? 's' }}</span>
        <span><b>{{ stats.following|format_number(locale: 'fr') }}</b> abonnement{{ stats.following > 1 ? 's' }}</span>
        <span class="stats-src">{{ ui.icon('globe', 'xs') }}chiffres de {{ account.domain }}</span>
    {% elseif can_view_network %}
        <a href="{{ path('app_profile_followers', {username: account.acct}) }}"><b>{{ stats.followers|format_number(locale: 'fr') }}</b> abonné{{ stats.followers > 1 ? 's' }}</a>
        <a href="{{ path('app_profile_following', {username: account.acct}) }}"><b>{{ stats.following|format_number(locale: 'fr') }}</b> abonnement{{ stats.following > 1 ? 's' }}</a>
    {% else %}
        <span title="Liste réservée aux abonnés"><b>{{ stats.followers|format_number(locale: 'fr') }}</b> abonné{{ stats.followers > 1 ? 's' }}</span>
        <span title="Liste réservée aux abonnés"><b>{{ stats.following|format_number(locale: 'fr') }}</b> abonnement{{ stats.following > 1 ? 's' }}</span>
    {% endif %}
    {% if pending_requests|default(0) %}<a href="{{ path('app_follow_requests') }}"><b>{{ pending_requests|format_number(locale: 'fr') }}</b> demande{{ pending_requests > 1 ? 's' }}</a>{% endif %}
</div>
{% endblock %}
