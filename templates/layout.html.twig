{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% set current_route = app.request.attributes.get('_route') %}
{% set me = app.user ? app.user.account : null %}

{% block body %}
<header class="mtop">
    <a class="logo" href="{{ path('app_home') }}"><span class="logo-mark"></span><span>social<b>ize</b></span></a>
    {% if me %}
        <a class="ib" href="{{ path('app_compose') }}" aria-label="Créer une publication">{{ ui.icon('plus') }}</a>
        <a class="ib" href="{{ path('app_settings') }}" aria-label="Réglages">{{ ui.icon('sliders') }}</a>
    {% else %}
        <a class="btn sm pri" href="{{ path('app_login') }}">Connexion</a>
    {% endif %}
</header>

<div class="app">
    <nav class="side" aria-label="Navigation principale">
        <a class="logo" href="{{ path('app_home') }}"><span class="logo-mark"></span><span>social<b>ize</b></span></a>
        <a class="nav{{ current_route == 'app_home' ? ' on' }}" href="{{ path('app_home') }}"{% if current_route == 'app_home' %} aria-current="page"{% endif %}>{{ ui.icon('home') }}<span class="lbl">Accueil</span></a>
        <a class="nav{{ current_route == 'app_feed_local' ? ' on' }}" href="{{ path('app_feed_local') }}"{% if current_route == 'app_feed_local' %} aria-current="page"{% endif %}>{{ ui.icon('compass') }}<span class="lbl">Local</span></a>
        <a class="nav{{ current_route == 'app_search' ? ' on' }}" href="{{ path('app_search') }}">{{ ui.icon('search') }}<span class="lbl">Rechercher</span></a>
        {% if me %}
            <a class="nav{{ current_route == 'app_compose' ? ' on' }}" href="{{ path('app_compose') }}">{{ ui.icon('plus') }}<span class="lbl">Créer</span></a>
            <a class="nav{{ current_route == 'app_profile' and account is defined and account.id == me.id ? ' on' }}" href="{{ path('app_profile', {username: me.username}) }}">{{ ui.icon('user') }}<span class="lbl">Profil</span></a>
            <div class="sep"></div>
            <a class="nav{{ (current_route ?? '') starts with 'app_import' ? ' on' }}" href="{{ path('app_import') }}">{{ ui.icon('download') }}<span class="lbl">Import Instagram</span></a>
            <a class="nav{{ current_route == 'app_settings' ? ' on' }}" href="{{ path('app_settings') }}">{{ ui.icon('sliders') }}<span class="lbl">Réglages</span></a>
        {% else %}
            <div class="sep"></div>
            <a class="nav{{ current_route == 'app_login' ? ' on' }}" href="{{ path('app_login') }}">{{ ui.icon('login') }}<span class="lbl">Connexion</span></a>
            <a class="nav{{ current_route == 'app_register' ? ' on' }}" href="{{ path('app_register') }}">{{ ui.icon('user') }}<span class="lbl">Créer un compte</span></a>
        {% endif %}
        <div class="grow"></div>
        <button class="nav" type="button" data-controller="theme" data-action="theme#toggle">{{ ui.icon('moon') }}<span class="lbl" data-theme-target="label">Changer de thème</span></button>
        {% if me %}
            <a class="nav" href="{{ path('app_logout') }}">{{ ui.icon('logout') }}<span class="lbl">Déconnexion</span></a>
        {% endif %}
        <p class="side-version" title="Version de Socialize">{{ app_version }}</p>
    </nav>

    <main id="main">
        {% set flashes = app.flashes %}
        {% if flashes is not empty %}
            <div class="flashes" role="status">
                {% for type, messages in flashes %}
                    {% for message in messages %}
                        <div class="flash {{ type }}">{{ ui.icon(type == 'error' ? 'flag' : 'check', 'sm') }}<span>{{ message }}</span></div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}
        <div class="view">{% block content %}{% endblock %}</div>
    </main>
</div>

<dialog class="share-sheet" data-controller="share" data-action="socialize:share@window->share#open click->share#backdrop" aria-labelledby="share-title">
    <div class="sheet">
        <header><b id="share-title">Partager</b><button type="button" class="ib" data-action="share#close" aria-label="Fermer">{{ ui.icon('x') }}</button></header>
        <button type="button" class="opt" data-share-target="native" data-action="share#native" hidden>{{ ui.icon('send') }}<span>Partager via…<small>Applications de votre appareil</small></span></button>
        <a class="opt" data-share-target="mail" href="mailto:">{{ ui.icon('send') }}<span>E-mail</span></a>
        <button type="button" class="opt" data-action="share#copy">{{ ui.icon('link') }}<span>Copier le lien</span></button>
        <a class="opt" data-share-target="facebook" href="https://www.facebook.com/" target="_blank" rel="noopener" data-action="share#close">{{ ui.icon('globe') }}<span>Facebook</span></a>
        <button type="button" class="opt" data-action="share#instagram">{{ ui.icon('image') }}<span>Instagram<small>Envoie la photo ou la vidéo à l’application, sinon copie le lien</small></span></button>
    </div>
</dialog>

<nav class="tabbar" aria-label="Navigation mobile">
    <a href="{{ path('app_home') }}" class="{{ current_route == 'app_home' ? 'on' }}" aria-label="Accueil">{{ ui.icon('home') }}</a>
    <a href="{{ path('app_feed_local') }}" class="{{ current_route == 'app_feed_local' ? 'on' }}" aria-label="Fil local">{{ ui.icon('compass') }}</a>
    {% if me %}
        <a href="{{ path('app_compose') }}" class="plus" aria-label="Créer une publication">{{ ui.icon('plus') }}</a>
        <a href="{{ path('app_settings') }}" class="{{ current_route == 'app_settings' ? 'on' }}" aria-label="Réglages">{{ ui.icon('sliders') }}</a>
        <a href="{{ path('app_profile', {username: me.username}) }}" aria-label="Profil">{{ ui.avatar(me, 26) }}</a>
    {% else %}
        <a href="{{ path('app_login') }}" class="plus" aria-label="Connexion">{{ ui.icon('login') }}</a>
    {% endif %}
</nav>
{% endblock %}
