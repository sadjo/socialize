{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% set current_route = app.request.attributes.get('_route') %}
{% set me = app.user ? app.user.account : null %}
{# Instance réservée aux comptes (temporaire) : pas de menu pour un visiteur sur un profil public ;
   la connexion se fait depuis l'accueil. #}
{% set visitor_closed = home_login_only and not me %}
{# Profil public (visiteur non connecté sur /@compte) : ni menu, ni logo, ni barres ; pied de page « Propulsé par ». #}
{% set public_profile = not me and (current_route ?? '') starts with 'app_profile' %}
{% set show_menu = not public_profile %}
{% set login_url = visitor_closed ? path('app_home') : path('app_login') %}

{% block body %}
{% if not public_profile %}
<header class="mtop">
    {# Application ouverte depuis l'écran d'accueil : pas de barre du navigateur, donc un bouton Retour. #}
    {% if current_route != 'app_home' %}<button type="button" class="ib back-btn" data-controller="history" data-action="history#back" aria-label="Retour">{{ ui.icon('left') }}</button>{% endif %}
    <a class="logo" href="{{ path('app_home') }}"><span class="logo-mark"></span><span>social<b>ize</b></span></a>
    {% if me %}
        {% if is_granted('ROLE_PUBLISHER') %}<button type="button" class="ib" popovertarget="create-menu" aria-haspopup="dialog" aria-label="Créer">{{ ui.icon('plus') }}</button>{% elseif is_granted('ROLE_MASTODON') %}<a class="ib" href="{{ path('app_mastodon_compose') }}" aria-label="Publier">{{ ui.icon('plus') }}</a>{% endif %}
        <span data-controller="mobile-menu">
            <button type="button" class="ib" data-action="mobile-menu#open" aria-label="Menu" aria-haspopup="dialog">{{ ui.icon('menu') }}</button>
            <dialog class="mobile-menu" data-mobile-menu-target="dialog" data-action="click->mobile-menu#backdrop" aria-label="Menu">
                <div class="sheet">
                    <header><b>Menu</b><button type="button" class="ib" data-action="mobile-menu#close" aria-label="Fermer">{{ ui.icon('x', 'sm') }}</button></header>
                    <nav aria-label="Navigation (menu mobile)" data-action="click->mobile-menu#followed">
                        {{ include('_nav.html.twig') }}
                    </nav>
                </div>
            </dialog>
        </span>
    {% else %}
        <a class="btn sm pri" href="{{ login_url }}">Connexion</a>
    {% endif %}
</header>
{% endif %}

<div class="app{{ show_menu ? '' : ' no-menu' }}">
    {% if show_menu %}
    <nav class="side" aria-label="Navigation principale">
        <a class="logo" href="{{ path('app_home') }}"><span class="logo-mark"></span><span>social<b>ize</b></span></a>
        {{ include('_nav.html.twig') }}
    </nav>
    {% endif %}

    <main id="main">
        {# Messages d'information seulement : les autres (lien d'invitation…) sont affichés par leur page. #}
        {% set flashes = app.flashes(['success', 'error']) %}
        {% if flashes is not empty %}
            <div class="flashes" role="status">
                {% for type, messages in flashes %}
                    {% for message in messages %}
                        <div class="flash {{ type }}">{{ ui.icon(type == 'error' ? 'flag' : 'check', 'sm') }}<span>{{ message }}</span></div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}
        <div class="view">{% block content %}{% endblock %}</div>
        {% if public_profile %}
            <footer class="powered">Propulsé par <a href="{{ path('app_home') }}">socialize.example</a> · Version {{ app_version|trim('v', 'left') }}</footer>
        {% endif %}
    </main>
</div>

<dialog class="share-sheet" data-controller="share" data-action="socialize:share@window->share#open click->share#backdrop" aria-labelledby="share-title">
    <div class="sheet">
        <header><b id="share-title">Partager</b><button type="button" class="ib" data-action="share#close" aria-label="Fermer">{{ ui.icon('x') }}</button></header>
        <button type="button" class="opt" data-share-target="native" data-action="share#native" hidden>{{ ui.icon('send') }}<span>Partager via…<small>Applications de votre appareil</small></span></button>
        <a class="opt" data-share-target="mail" href="mailto:">{{ ui.icon('send') }}<span>E-mail</span></a>
        <button type="button" class="opt" data-action="share#copy">{{ ui.icon('link') }}<span>Copier le lien</span></button>
        <a class="opt" data-share-target="facebook" href="https://www.facebook.com/" target="_blank" rel="noopener" data-action="share#close">{{ ui.icon('globe') }}<span>Facebook</span></a>
        <button type="button" class="opt" data-action="share#instagram">{{ ui.icon('image') }}<span>Instagram<small>Envoie la photo ou la vidéo à l’application, sinon copie le lien</small></span></button>
    </div>
</dialog>

{% if me and is_granted('ROLE_PUBLISHER') %}
{# Choix offert par les boutons « Créer » (menu, barre du haut et du bas) : publication ou story. #}
<div id="create-menu" class="create-menu" popover role="dialog" aria-labelledby="create-title">
    <div class="sheet">
        <header><b id="create-title">Créer</b><button type="button" class="ib" popovertarget="create-menu" popovertargetaction="hide" aria-label="Fermer">{{ ui.icon('x') }}</button></header>
        <a class="opt" href="{{ path('app_compose') }}">{{ ui.icon('image') }}<span>Publication<small>Photos et vidéos, dans le fil et sur votre profil</small></span></a>
        <a class="opt" href="{{ path('app_story_new') }}">{{ ui.icon('reel') }}<span>Story<small>Visible 24 heures</small></span></a>
    </div>
</div>
{% endif %}

{% if show_menu %}
<nav class="tabbar" aria-label="Navigation mobile">
    <a href="{{ path('app_home') }}" class="{{ current_route == 'app_home' ? 'on' }}" aria-label="Publications">{{ ui.icon('image') }}</a>
    {% if me or not home_login_only %}<a href="{{ path('app_feed_local') }}" class="{{ current_route == 'app_feed_local' ? 'on' }}" aria-label="Fil local">{{ ui.icon('compass') }}</a>{% endif %}
    {% if me %}
        {% if is_granted('ROLE_PUBLISHER') %}<button type="button" class="plus" popovertarget="create-menu" aria-haspopup="dialog" aria-label="Créer">{{ ui.icon('plus') }}</button>{% elseif is_granted('ROLE_MASTODON') %}<a class="plus" href="{{ path('app_mastodon_compose') }}" aria-label="Publier">{{ ui.icon('plus') }}</a>{% endif %}
        {# Notifications à la place des réglages (toujours dans le menu). #}
        {% set unread = is_granted('ROLE_MASTODON') ? 0 : unread_notifications() %}
        {% if not is_granted('ROLE_MASTODON') %}<a href="{{ path('app_notifications') }}" class="notif-link{{ current_route == 'app_notifications' ? ' on' }}" aria-label="Notifications{{ unread ? ' (' ~ unread ~ ' non lue' ~ (unread > 1 ? 's') ~ ')' }}">{{ ui.icon('bell') }}{% if unread %}<span class="badge num" aria-hidden="true">{{ unread > 99 ? '99+' : unread }}</span>{% endif %}</a>{% endif %}
        <a href="{{ path('app_profile', {username: me.acct}) }}" aria-label="Profil">{{ ui.avatar(me, 26) }}</a>
    {% else %}
        <a href="{{ login_url }}" class="plus" aria-label="Connexion">{{ ui.icon('login') }}</a>
    {% endif %}
</nav>
{% endif %}
{% endblock %}
