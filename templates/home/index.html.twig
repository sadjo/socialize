{% extends 'base.html.twig' %}

{% block title %}Socialize · Socle opérationnel{% endblock %}

{% block body %}
<main class="socle">
    <a class="logo" href="{{ path('app_home') }}"><span class="logo-mark" aria-hidden="true"></span><span>social<b>ize</b></span></a>

    <section class="card">
        <h1>Le socle fonctionne</h1>
        <p class="lead">Cette instance Socialize est prête à recevoir les premières fonctionnalités : comptes, publications et fil.</p>

        <dl class="status">
            <div><dt>PHP</dt><dd>{{ status.phpVersion }}</dd></div>
            <div><dt>Symfony</dt><dd>{{ status.symfonyVersion }}</dd></div>
            <div>
                <dt>Base de données</dt>
                <dd>
                    {{ status.databasePlatform }}
                    {% if status.databaseReachable %}
                        <span class="pill ok">Connectée</span>
                    {% else %}
                        <span class="pill bad">Injoignable</span>
                    {% endif %}
                </dd>
            </div>
            <div>
                <dt>Mode worker FrankenPHP</dt>
                <dd>
                    {% if status.workerMode %}<span class="pill ok">Actif</span>{% else %}<span class="pill idle">Inactif</span>{% endif %}
                </dd>
            </div>
        </dl>

        <p class="small">État technique au format JSON : <a href="{{ path('app_health') }}"><code>/healthz</code></a></p>
    </section>
</main>
{% endblock %}
