{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}{{ chapter.title }} · Aide · Socialize{% endblock %}

{% block content %}
<div class="page-narrow">
    <div class="page-h"><div class="grow"><p class="help-crumb"><a href="{{ path('app_help') }}">Aide</a></p><h1>{{ chapter.title }}</h1></div></div>
    <article class="card help-body">{{ html|raw }}</article>
    <nav class="help-nav" aria-label="Chapitres voisins">
        {% if previous %}<a class="btn ghost" href="{{ path('app_help_page', {slug: previous.slug}) }}" rel="prev">{{ ui.icon('left', 'xs') }}{{ previous.title }}</a>{% else %}<span></span>{% endif %}
        {% if next %}<a class="btn ghost" href="{{ path('app_help_page', {slug: next.slug}) }}" rel="next">{{ next.title }}{{ ui.icon('right', 'xs') }}</a>{% endif %}
    </nav>
    <details class="help-all">
        <summary>Tous les chapitres</summary>
        <ol>{% for c in chapters %}<li>{% if c.slug == chapter.slug %}<b>{{ c.title }}</b>{% else %}<a href="{{ path('app_help_page', {slug: c.slug}) }}">{{ c.title }}</a>{% endif %}</li>{% endfor %}</ol>
    </details>
</div>
{% endblock %}
