{% use 'form_div_layout.html.twig' %}

{% block form_row -%}
    {%- set widget_attr = {} -%}
    {%- if help is not empty -%}
        {%- set widget_attr = {attr: {'aria-describedby': id ~ '_help'}} -%}
    {%- endif -%}
    <div class="field{{ not valid ? ' invalid' }}">
        {{- form_label(form) -}}
        {{- form_widget(form, widget_attr) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock form_row %}

{% block form_widget_simple -%}
    {%- if type is not defined or type not in ['file', 'hidden', 'checkbox', 'radio'] -%}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' inp')|trim}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock form_widget_simple %}

{% block textarea_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' inp')|trim}) -%}
    {{- parent() -}}
{%- endblock textarea_widget %}

{% block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="{{ form.parent ? 'field-errors' : 'form-errors' }}">
            {%- for error in errors -%}<li>{{ error.message }}</li>{%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors %}

{% block form_help -%}
    {%- if help is not empty -%}
        <p id="{{ id }}_help" class="help">{{ help }}</p>
    {%- endif -%}
{%- endblock form_help %}
