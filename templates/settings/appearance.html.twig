{% extends 'layout.html.twig' %}

{% block title %}Apparence · Réglages · Socialize{% endblock %}

{% block content %}
<div class="page-narrow">
    <div class="page-h"><div class="grow"><h1>Réglages</h1><p>Compte {{ handle(account, local_domain) }}</p></div></div>
    {{ include('settings/_tabs.html.twig', {current: 'appearance'}) }}

    <section class="card stack">
        <h2>Apparence</h2>
        <p class="small">Vos choix s’affichent tout de suite pour voir le rendu ; enregistrez-les pour les garder. Ils suivent votre compte sur tous vos appareils.</p>

        {# Aperçu immédiat du thème et du filtre cochés (assets/controllers/appearance_preview_controller.js). #}
        {{ form_start(form, {attr: {class: 'form', 'data-controller': 'appearance-preview', 'data-action': 'submit->appearance-preview#submit'}}) }}
            {{ form_errors(form) }}
            <fieldset class="field">
                <legend class="lab">{{ form.theme.vars.label }}</legend>
                <div class="choices themes">
                    {% for choice in form.theme %}
                        {% set theme = (form.theme.vars.choices|filter(c => c.value == choice.vars.value)|first).data %}
                        {# Bouton radio puis étiquette : la pastille cochée est surlignée (.choices input:checked + label). #}
                        {{ form_widget(choice, {attr: {'data-action': 'change->appearance-preview#preview', 'data-appearance-preview-attr-param': 'theme'}}) }}<label for="{{ choice.vars.id }}"><span class="theme-swatch" data-swatch="{{ theme.value }}" aria-hidden="true"></span>{{ choice.vars.label }}<small>{{ theme.description }}</small></label>
                    {% endfor %}
                </div>
            </fieldset>
            <fieldset class="field">
                <legend class="lab">{{ form.mediaFilter.vars.label }}</legend>
                <p class="help">Adoucit et rapproche les couleurs des photos et vidéos dans les fils et les grilles. La page d’une publication et l’affichage en plein écran gardent les couleurs d’origine.</p>
                <div class="choices">
                    {% for choice in form.mediaFilter %}
                        {% set filter = (form.mediaFilter.vars.choices|filter(c => c.value == choice.vars.value)|first).data %}
                        {{ form_widget(choice, {attr: {'data-action': 'change->appearance-preview#preview', 'data-appearance-preview-attr-param': 'mediaFilter'}}) }}<label for="{{ choice.vars.id }}">{{ choice.vars.label }}<small>{{ filter.description }}</small></label>
                    {% endfor %}
                </div>
                {% if samples is not empty %}
                    {# Vos dernières publications, filtrées comme dans une grille (.gt). #}
                    <div class="grid3 filter-samples" aria-label="Aperçu sur vos dernières publications">
                        {% for post in samples %}
                            {% set cover = post.cover %}
                            {% set thumb = cover and cover.ready ? media_url(cover, 'thumb') : null %}
                            {% if thumb %}<span class="gt"><img src="{{ thumb }}" alt="{{ cover.altText }}" loading="lazy" decoding="async"></span>{% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            </fieldset>
            <div class="navbtns"><span></span><button class="btn pri">Enregistrer</button></div>
        {{ form_end(form) }}
    </section>
</div>
{% endblock %}
