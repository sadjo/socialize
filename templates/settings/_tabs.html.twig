{# Onglets des réglages. Variable : current ('profile', 'appearance', 'password', 'groups', 'immich', 'synology' ou 'instagram') #}
{% import '_macros.html.twig' as ui %}
<div class="ptabs-wrap" data-controller="tabs">
<button type="button" class="ptabs-arrow prev" data-tabs-target="prev" data-action="tabs#previous" aria-label="Onglets précédents" tabindex="-1" hidden>{{ ui.icon('left', 'sm') }}</button>
<nav class="ptabs ptabs-scroll" aria-label="Réglages" data-tabs-target="strip" data-action="scroll->tabs#update wheel->tabs#wheel:!passive">
    {# Compte Mastodon : seule l'apparence se règle ici, le reste sur son serveur. #}
    {% set mastodon = is_granted('ROLE_MASTODON') %}
    {% if not mastodon %}<a href="{{ path('app_settings') }}" class="{{ current == 'profile' ? 'on' }}"{{ current == 'profile' ? ' aria-current="page"' }}>{{ ui.icon('user', 'xs') }}Profil</a>{% endif %}
    <a href="{{ path('app_settings_appearance') }}" class="{{ current == 'appearance' ? 'on' }}"{{ current == 'appearance' ? ' aria-current="page"' }}>{{ ui.icon('moon', 'xs') }}Apparence</a>
    {% if not mastodon %}<a href="{{ path('app_settings_password') }}" class="{{ current == 'password' ? 'on' }}"{{ current == 'password' ? ' aria-current="page"' }}>{{ ui.icon('key', 'xs') }}Mot de passe</a>{% endif %}
    {% if not mastodon %}<a href="{{ path('app_settings_groups') }}" class="{{ current == 'groups' ? 'on' }}"{{ current == 'groups' ? ' aria-current="page"' }}>{{ ui.icon('stack', 'xs') }}Groupes</a>{% endif %}
    {% if is_granted('ROLE_PUBLISHER') %}<a href="{{ path('app_settings_immich') }}" class="{{ current == 'immich' ? 'on' }}"{{ current == 'immich' ? ' aria-current="page"' }}>{{ ui.icon('album', 'xs') }}Immich</a>{% endif %}
    {% if is_granted('ROLE_PUBLISHER') %}<a href="{{ path('app_settings_synology_photos') }}" class="{{ current == 'synology' ? 'on' }}"{{ current == 'synology' ? ' aria-current="page"' }}>{{ ui.icon('album', 'xs') }}Synology</a>{% endif %}
    {% if is_granted('ROLE_PUBLISHER') or (mastodon and is_granted('ROLE_INSTAGRAM_IMPORTER')) %}<a href="{{ path('app_settings_instagram') }}" class="{{ current == 'instagram' ? 'on' }}"{{ current == 'instagram' ? ' aria-current="page"' }}>{{ ui.icon('image', 'xs') }}Instagram</a>{% endif %}
</nav>
<button type="button" class="ptabs-arrow next" data-tabs-target="next" data-action="tabs#next" aria-label="Onglets suivants" tabindex="-1" hidden>{{ ui.icon('right', 'sm') }}</button>
</div>
