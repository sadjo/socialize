{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}Réglages · Socialize{% endblock %}

{% block content %}
<div class="page-narrow">
    <div class="page-h"><div class="grow"><h1>Réglages</h1><p>Compte {{ handle(account, local_domain) }}</p></div></div>
    {{ include('settings/_tabs.html.twig', {current: 'profile'}) }}
    <section class="card">
        <h2>Profil public</h2>
        {{ form_start(form, {attr: {class: 'form'}}) }}
            {{ form_errors(form) }}
            {{ include('profile/_images_picker.html.twig', {account: account, avatar: form.avatar, cover: form.cover, remove_cover: form.removeCover}) }}
            {{ form_row(form.displayName) }}
            {{ form_row(form.bio) }}
            <label class="chk">{{ form_widget(form.hideNetwork) }}<span>{{ form.hideNetwork.vars.label }}<br><small>Les autres visiteurs verront seulement le nombre d’abonnés et d’abonnements.</small></span></label>
            <div><button class="btn pri">Enregistrer</button></div>
        {{ form_end(form) }}
    </section>
    <p class="small">Le crosspost Facebook, les jetons API et le serveur MCP arriveront dans les prochaines versions.</p>
</div>
{% endblock %}
