{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}Immich · Réglages · Socialize{% endblock %}

{% block content %}
<div class="page-narrow">
    <div class="page-h"><div class="grow"><h1>Réglages{{ ui.help('phototheques', 'immich', 'Immich') }}</h1><p>Compte {{ handle(account, local_domain) }}</p></div></div>
    {{ include('settings/_tabs.html.twig', {current: 'immich'}) }}

    <section class="card stack">
        <h2>Connexion Immich</h2>
        <p class="small">Choisissez vos photos et vidéos directement dans votre photothèque <a class="lnk" href="https://immich.app" target="_blank" rel="noopener">Immich</a>, au moment de créer une publication ou une story. L’original et ses métadonnées sont copiés au moment de publier.</p>

        {% if connection %}
            <div class="zip">
                <span class="ico">{{ ui.icon('album') }}</span>
                <span class="grow">
                    <b>{{ connection.serverUrl }}</b><br>
                    <small>{{ connection.immichUser }}{{ connection.serverVersion ? ' · Immich ' ~ connection.serverVersion }} · testée le {{ connection.checkedAt|format_datetime('long', 'short', locale: 'fr') }}</small>
                </span>
                <span class="chip on">{{ ui.icon('check', 'xs') }}Connecté</span>
            </div>
        {% endif %}

        {{ form_start(form, {attr: {class: 'form'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.serverUrl) }}
            {{ form_row(form.apiKey) }}
            <label class="chk">{{ form_widget(form.addToAlbum) }}<span>{{ form.addToAlbum.vars.label }}<br><small>L’album est créé dans Immich à la première publication.</small></span></label>
            <div class="note">{{ ui.icon('key', 'sm') }}<span>Créez la clé dans Immich › Paramètres du compte › Clés API, avec ces droits : <code>user.read</code>, <code>asset.read</code>, <code>asset.view</code>, <code>asset.download</code>, <code>asset.statistics</code>, <code>album.read</code>, et pour l’album <code>album.create</code> et <code>albumAsset.create</code>. La clé est chiffrée sur ce serveur et n’est jamais réaffichée.</span></div>
            <div class="navbtns"><span></span><button class="btn pri">{{ connection ? 'Tester et enregistrer' : 'Tester la connexion' }}</button></div>
        {{ form_end(form) }}

        {% if connection %}
            <form method="post" action="{{ path('app_settings_immich_disconnect') }}" data-turbo-confirm="Déconnecter Immich ? La clé enregistrée sera supprimée.">
                <input type="hidden" name="_token" value="{{ csrf_token('immich-disconnect') }}">
                <button class="btn sm ghost danger">Déconnecter Immich</button>
            </form>
        {% endif %}
    </section>
</div>
{% endblock %}
