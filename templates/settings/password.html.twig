{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}Mot de passe · Réglages · Socialize{% endblock %}

{% block content %}
<div class="page-narrow">
    <div class="page-h"><div class="grow"><h1>Réglages{{ ui.help('compte-et-reglages', 'mot-de-passe', 'le mot de passe') }}</h1><p>Compte {{ handle(account, local_domain) }}</p></div></div>
    {{ include('settings/_tabs.html.twig', {current: 'password'}) }}

    <section class="card stack">
        <h2>Mot de passe</h2>
        <p class="small">Vos autres appareils et navigateurs seront déconnectés et devront se reconnecter avec le nouveau mot de passe ; celui-ci reste connecté.</p>
        {{ form_start(form, {attr: {class: 'form'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.currentPassword) }}
            {{ form_row(form.newPassword.first) }}
            {{ form_row(form.newPassword.second) }}
            <div><button class="btn pri">{{ ui.icon('key', 'xs') }}Changer le mot de passe</button></div>
        {{ form_end(form) }}
    </section>
</div>
{% endblock %}
