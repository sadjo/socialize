{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}Mes stories · Socialize{% endblock %}

{% macro tile(story, active) %}
    {% import '_macros.html.twig' as ui %}
    {% set media = story.media %}
    <article class="story-tile" id="story-{{ story.publicId }}">
        <div class="th-wrap">
            {% set url = active ? path('app_account_stories', {username: story.account.username}) : path('app_story_archive', {id: story.publicId}) %}
            <a class="th" href="{{ url }}" aria-label="Voir la story du {{ story.createdAt|format_datetime('long', 'short', locale: 'fr') }}">
                {% if media and media.ready %}<img src="{{ media_url(media, 'thumb') }}" alt="">{% else %}<span class="processing skel">{{ ui.icon('reel') }}</span>{% endif %}
                {% if media and media.video %}<span class="gi">{{ ui.icon('reel', 'sm') }}</span>{% endif %}
            </a>
            {# Case de sélection : les stories cochées partent ensemble à la une (formulaire « pin-form » plus haut). #}
            <label class="story-pick" title="Sélectionner pour la mettre à la une">
                <input type="checkbox" name="stories[]" value="{{ story.publicId }}" form="pin-form" data-action="story-selection#update" data-story-selection-target="box">
                <span class="sr-only">Sélectionner la story du {{ story.createdAt|format_datetime('long', 'short', locale: 'fr') }}</span>
            </label>
        </div>
        <small>{{ story.createdAt|ago }}{{ active ? ' · en cours' : '' }} · {{ story.viewsCount }} vue{{ story.viewsCount > 1 ? 's' }}</small>
        {# Envoi vers Instagram : en ligne (lien), en cours, ou échec avec nouvel essai — comme pour une publication. #}
        {{ include('post/_crosspost_status.html.twig', {crosspost: instagram_crosspost(story)}) }}
        {% if story.highlight %}
            <span class="chip on" title="À la une : {{ story.highlight.title }}">{{ ui.icon('sparkle', 'xs') }}<span class="ellipsis">{{ story.highlight.title }}</span></span>
            <form method="post" action="{{ path('app_story_unpin', {id: story.publicId}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('story-unpin-' ~ story.publicId) }}">
                <button class="btn sm">Retirer de la une</button>
            </form>
        {% endif %}
        {% if media and media.ready %}
            {{ include('post/_share_instagram.html.twig', {files: [{url: path('app_story_share_file', {id: story.publicId}), name: 'socialize-story-' ~ story.publicId ~ (media.video ? '.mp4' : '.jpg'), type: media.video ? 'video/mp4' : 'image/jpeg'}], caption: story.text ?? '', class: 'btn sm'}) }}
        {% endif %}
        <form method="post" action="{{ path('app_story_delete', {id: story.publicId}) }}" data-turbo-confirm="Supprimer définitivement cette story ?">
            <input type="hidden" name="_token" value="{{ csrf_token('story-delete-' ~ story.publicId) }}">
            <button class="btn sm ghost danger">{{ ui.icon('trash', 'xs') }}Supprimer</button>
        </form>
    </article>
{% endmacro %}

{% block content %}
<div class="page" data-controller="story-selection">
    <div class="page-h">
        <div class="grow"><h1>Mes stories{{ ui.help('stories', 'mettre-une-story-à-la-une', 'les stories à la une') }}</h1><p>Les stories restent visibles 24 h, puis rejoignent vos archives, visibles par vous seul. Cochez-en une ou plusieurs pour les mettre à la une et les garder sur votre profil.</p></div>
        {% if is_granted('ROLE_PUBLISHER') %}<a class="btn pri" href="{{ path('app_story_new') }}">{{ ui.icon('plus', 'sm') }}Nouvelle story</a>{% endif %}
    </div>

    {% if highlights is not empty %}
        <section class="card">
            <h2>Stories à la une</h2>
            <div class="hl-list">
                {% for highlight in highlights %}
                    {% set cover = highlight_cover_url(highlight) %}
                    <div class="dom">
                        <span class="hl-cover">{% if cover %}<img src="{{ cover }}" alt="">{% endif %}</span>
                        <span class="grow"><b>{{ highlight.title }}</b> · {{ highlight.stories|length }} stor{{ highlight.stories|length > 1 ? 'ies' : 'y' }}</span>
                        <a class="btn sm" href="{{ path('app_highlight', {username: app.user.account.username, id: highlight.publicId}) }}">Voir</a>
                        <a class="btn sm" href="{{ path('app_highlight_edit', {id: highlight.publicId}) }}">{{ ui.icon('sliders', 'xs') }}Modifier</a>
                        <form method="post" action="{{ path('app_highlight_delete', {id: highlight.publicId}) }}" data-turbo-confirm="Supprimer cette story à la une ? Ses stories restent dans vos archives.">
                            <input type="hidden" name="_token" value="{{ csrf_token('highlight-delete-' ~ highlight.publicId) }}">
                            <button class="btn sm ghost danger">Supprimer</button>
                        </form>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if active is not empty or archive is not empty %}
        {# Mise à la une des stories cochées : une barre qui reste visible pendant qu'on fait défiler les vignettes. #}
        <form method="post" action="{{ path('app_story_pin') }}" id="pin-form" class="pin-bar card">
            <input type="hidden" name="_token" value="{{ csrf_token('story-pin') }}">
            <span class="small" data-story-selection-target="count" aria-live="polite">Cochez les stories à mettre à la une.</span>
            <div class="row wrap">
                <label class="sr-only" for="pin-highlight">Story à la une</label>
                <select class="inp sm" name="highlight" id="pin-highlight" data-story-selection-target="highlight" data-action="story-selection#update">
                    {% for highlight in highlights %}<option value="{{ highlight.publicId }}">{{ highlight.title }}</option>{% endfor %}
                    <option value="__new__"{{ highlights is empty ? ' selected' }}>Nouvelle story à la une…</option>
                </select>
                <input class="inp sm" name="title" placeholder="Titre de la nouvelle" maxlength="30" aria-label="Titre de la nouvelle story à la une" data-story-selection-target="title">
                <button class="btn sm pri" data-story-selection-target="submit">{{ ui.icon('sparkle', 'xs') }}Mettre à la une</button>
            </div>
        </form>
    {% endif %}

    <section class="card">
        <h2>En cours</h2>
        {% if active is empty %}<p class="small">Aucune story en cours.</p>{% else %}
            <div class="story-grid">{% for story in active %}{{ _self.tile(story, true) }}{% endfor %}</div>
        {% endif %}
    </section>

    <section class="card">
        <h2>Archives</h2>
        {% if archive is empty %}<p class="small">Vos stories expirées apparaîtront ici.</p>{% else %}
            <div class="story-grid">{% for story in archive %}{{ _self.tile(story, false) }}{% endfor %}</div>
        {% endif %}
    </section>
</div>
{% endblock %}
