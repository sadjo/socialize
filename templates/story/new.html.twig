{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}Nouvelle story · Socialize{% endblock %}

{% block content %}
<div class="compose">
    <div class="page-h"><div class="grow"><h1>Nouvelle story</h1><p>Visible 24 h, puis rangée dans vos archives. Vous pouvez la mettre à la une pour la garder sur votre profil.</p></div></div>
    {{ form_start(form, {attr: {class: 'form', 'data-controller': 'compose', 'data-compose-max-value': 10}}) }}
        {{ form_errors(form) }}
        <div class="compose-grid">
            <section class="card picker">
                {{ include('compose/_sources.html.twig', {drop_label: 'Choisissez des photos ou des vidéos', drop_hint: form.media.vars.help ~ ' Format vertical conseillé (9:16).'}) }}
                {{ form_widget(form.media) }}
                {{ form_widget(form.order) }}
                {{ form_errors(form.media) }}
                <p class="small">Les stories sont lues dans l’ordre des aperçus : faites-les glisser, ou utilisez ◀ ▶.</p>
                <div class="previews" data-compose-target="previews" aria-live="polite"></div>

            </section>
            <section class="card">
                {{ form_row(form.text, {attr: {'data-compose-target': 'caption'}}) }}
                <div class="counter num" data-compose-target="counter" hidden></div>
                {{ include('compose/_audience.html.twig', {field: form.audience, groups: form.audienceGroups, legend: 'Visible par', descriptions: {public: 'Tous les visiteurs', followers: 'Seulement vos abonnés', groups: 'Vos groupes d’abonnés'}}) }}
                {{ form_row(form.highlight) }}
                {{ form_row(form.highlightTitle) }}
                {{ include('compose/_music.html.twig', {field: form.music}) }}
                {{ include('compose/_crosspost.html.twig', {visibility_field: 'audience'}) }}
                <button class="btn pri" data-compose-target="submit">Partager la story</button>
            </section>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
