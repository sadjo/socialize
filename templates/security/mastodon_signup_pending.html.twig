{% extends 'layout.html.twig' %}

{% block title %}Confirmez votre adresse · Socialize{% endblock %}

{% block content %}
{# Compte Mastodon créé, adresse e-mail à confirmer. Variables : pending (domain, username, approval), error #}
<div class="auth">
    <a class="logo" href="{{ path('app_home') }}"><span class="logo-mark"></span><span>social<b>ize</b></span></a>
    <section class="card stack">
        <h1>Confirmez votre adresse</h1>
        <p>Votre compte <b>@{{ pending.username }}@{{ pending.domain }}</b> est créé. {{ pending.domain }} vient de vous envoyer un e-mail : ouvrez le lien qu’il contient pour confirmer votre adresse, puis revenez ici.</p>
        {% if pending.approval %}<p class="small">L’équipe de {{ pending.domain }} doit aussi valider votre inscription. Si elle ne l’a pas encore fait, revenez vous connecter avec Mastodon une fois acceptée.</p>{% endif %}
        {% if error %}<p class="field-errors" role="alert">{{ error }}</p>{% endif %}
        <form method="post" action="{{ path('app_mastodon_signup_confirm') }}" class="form">
            <input type="hidden" name="_token" value="{{ csrf_token('mastodon-signup-confirm') }}">
            <button class="btn pri">J’ai confirmé mon adresse</button>
        </form>
        <p class="small">Pas d’e-mail ? Regardez dans les indésirables. Vous pourrez aussi vous connecter plus tard avec « Se connecter avec {{ pending.domain }} ».</p>
    </section>
</div>
{% endblock %}
