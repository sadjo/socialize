{% extends 'layout.html.twig' %}

{% block title %}Nouveau mot de passe · Socialize{% endblock %}

{% block content %}
{# Nouveau mot de passe, depuis le lien reçu par e-mail. Variables : form, account #}
<div class="auth">
    <a class="logo" href="{{ path('app_home') }}"><span class="logo-mark"></span><span>social<b>ize</b></span></a>
    <section class="card stack">
        <h1>Nouveau mot de passe</h1>
        <p class="small">Pour le compte <b>@{{ account.username }}</b>.</p>
        {{ form_start(form, {attr: {class: 'form'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.newPassword.first) }}
            {{ form_row(form.newPassword.second) }}
            <button class="btn pri">Changer le mot de passe</button>
        {{ form_end(form) }}
    </section>
</div>
{% endblock %}
