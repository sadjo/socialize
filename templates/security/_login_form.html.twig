{# Formulaire de connexion. Variables : error, last_email, registration_open #}
<div class="auth">
    <a class="logo" href="{{ path('app_home') }}"><span class="logo-mark"></span><span>social<b>ize</b></span></a>
    <section class="card">
        <h1>Connexion</h1>
        <form method="post" action="{{ path('app_login') }}" class="form">
            {% if error %}
                <ul class="form-errors"><li>{{ error.messageKey|trans(error.messageData, 'security') }}</li></ul>
            {% endif %}
            <div class="field">
                <label for="identifier">Adresse e-mail ou nom d’utilisateur</label>
                <input class="inp" type="text" id="identifier" name="identifier" value="{{ last_email }}" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
            </div>
            <div class="field">
                <label for="password">Mot de passe</label>
                <input class="inp" type="password" id="password" name="password" autocomplete="current-password" required>
            </div>
            <label class="row" for="remember_me"><input type="checkbox" class="sw" id="remember_me" name="_remember_me" checked> <span>Rester connecté 30 jours</span></label>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
            <button class="btn pri">Se connecter</button>
        </form>
    </section>
    {% set mastodon = mastodon_login() %}
    {% if mastodon %}
        {# Connexion avec un compte Mastodon : mastodon.social d'un clic, ou un autre serveur indiqué dans le champ.
           Départ vers la page d'autorisation du serveur, sans Turbo : il suivrait la redirection vers un autre
           domaine en arrière-plan, et rien ne se passerait. #}
        <section class="card mastodon-login">
            <h2>Avec votre compte Mastodon</h2>
            {% for server in mastodon.buttons %}
                <form method="post" action="{{ path('app_mastodon_login') }}" class="form" data-turbo="false">
                    <input type="hidden" name="server" value="{{ server }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('mastodon-login') }}">
                    <button class="btn{{ loop.first ? ' pri' }} wide">Se connecter avec {{ server }}</button>
                </form>
            {% endfor %}
            {% if mastodon.field is not null %}
                {% if mastodon.buttons is not empty %}<details class="mastodon-other"><summary class="small">Votre compte est sur un autre serveur ?</summary>{% endif %}
                <form method="post" action="{{ path('app_mastodon_login') }}" class="form" data-turbo="false">
                    <div class="field">
                        <label for="mastodon-server">Votre serveur Mastodon</label>
                        <input class="inp" type="text" id="mastodon-server" name="server" placeholder="{{ mastodon.field|first ?: 'piaille.fr' }}" autocapitalize="none" spellcheck="false" required{% if mastodon.field is not empty %} list="mastodon-servers"{% endif %}>
                        {% if mastodon.field is not empty %}
                            <datalist id="mastodon-servers">{% for server in mastodon.field %}<option value="{{ server }}">{% endfor %}</datalist>
                            <small>Serveurs acceptés : {{ mastodon.field|join(', ') }}</small>
                        {% else %}
                            <small>Son adresse, ou votre adresse complète : @nom@serveur</small>
                        {% endif %}
                    </div>
                    <input type="hidden" name="_token" value="{{ csrf_token('mastodon-login') }}">
                    <button class="btn">Se connecter</button>
                </form>
                {% if mastodon.buttons is not empty %}</details>{% endif %}
            {% endif %}
            {% set signup_server = mastodon_signup_server() %}
            {% if signup_server %}<p class="small">Pas encore de compte Mastodon ? <a class="lnk" href="{{ path('app_mastodon_signup') }}">Créer un compte sur {{ signup_server }}</a></p>{% endif %}
        </section>
    {% endif %}
    {% if registration_open and not home_login_only %}<p class="alt">Pas encore de compte ? <a class="lnk" href="{{ path('app_register') }}">Créer un compte</a></p>{% endif %}
</div>
