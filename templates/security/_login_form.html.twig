{# Formulaire de connexion. Variables : error, last_email, registration_open #}
<div class="auth">
    <a class="logo" href="{{ path('app_home') }}"><span class="logo-mark"></span><span>social<b>ize</b></span></a>
    <section class="card">
        <h1>Connexion</h1>
        <form method="post" action="{{ path('app_login') }}" class="form">
            {% if error %}
                <ul class="form-errors"><li>{{ error.messageKey|trans(error.messageData, 'security') }}</li></ul>
            {% endif %}
            <div class="field">
                <label for="identifier">Adresse e-mail ou nom d’utilisateur</label>
                <input class="inp" type="text" id="identifier" name="identifier" value="{{ last_email }}" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
            </div>
            <div class="field">
                <label for="password">Mot de passe</label>
                <input class="inp" type="password" id="password" name="password" autocomplete="current-password" required>
            </div>
            <label class="row" for="remember_me"><input type="checkbox" class="sw" id="remember_me" name="_remember_me" checked> <span>Rester connecté 30 jours</span></label>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
            <button class="btn pri">Se connecter</button>
        </form>
    </section>
    {% set mastodon_servers = mastodon_login_servers() %}
    {% if mastodon_servers is not null %}
        {# Connexion avec un compte Mastodon : départ vers la page d'autorisation de son serveur. Sans Turbo : il
           suivrait la redirection vers un autre domaine en arrière-plan, et rien ne se passerait. #}
        <section class="card mastodon-login">
            <h2>Avec votre compte Mastodon</h2>
            <form method="post" action="{{ path('app_mastodon_login') }}" class="form" data-turbo="false">
                <div class="field">
                    <label for="mastodon-server">Votre serveur Mastodon</label>
                    {% if mastodon_servers|length == 1 %}
                        <input type="hidden" id="mastodon-server" name="server" value="{{ mastodon_servers|first }}">
                        <p class="small">Compte sur <b>{{ mastodon_servers|first }}</b></p>
                    {% else %}
                        <input class="inp" type="text" id="mastodon-server" name="server" placeholder="{{ mastodon_servers|first ?: 'mastodon.social' }}" autocapitalize="none" spellcheck="false" required{% if mastodon_servers is not empty %} list="mastodon-servers"{% endif %}>
                        {% if mastodon_servers is not empty %}
                            <datalist id="mastodon-servers">{% for server in mastodon_servers %}<option value="{{ server }}">{% endfor %}</datalist>
                            <small>Serveurs acceptés : {{ mastodon_servers|join(', ') }}</small>
                        {% endif %}
                    {% endif %}
                </div>
                <input type="hidden" name="_token" value="{{ csrf_token('mastodon-login') }}">
                <button class="btn">Se connecter avec Mastodon</button>
            </form>
        </section>
    {% endif %}
    {% if registration_open and not home_login_only %}<p class="alt">Pas encore de compte ? <a class="lnk" href="{{ path('app_register') }}">Créer un compte</a></p>{% endif %}
</div>
