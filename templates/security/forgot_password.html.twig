{% extends 'layout.html.twig' %}

{% block title %}Mot de passe oublié · Socialize{% endblock %}

{% block content %}
{# « Mot de passe oublié » des comptes de l'instance. Variables : form #}
<div class="auth">
    <a class="logo" href="{{ path('app_home') }}"><span class="logo-mark"></span><span>social<b>ize</b></span></a>
    <section class="card stack">
        <h1>Mot de passe oublié</h1>
        <p class="small">Indiquez l’adresse e-mail ou le nom d’utilisateur de votre compte socialize.example : vous recevrez par e-mail un lien pour choisir un nouveau mot de passe.</p>
        {{ form_start(form, {attr: {class: 'form'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.identifier) }}
            <button class="btn pri">Recevoir le lien</button>
        {{ form_end(form) }}
    </section>
    <p class="alt"><a class="lnk" href="{{ path('app_login', {onglet: 'socialize'}) }}">Retour à la connexion</a></p>
</div>
{% endblock %}
