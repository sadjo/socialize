{# Sources des médias : l'appareil (zone de dépôt) et, si le compte y est connecté, ses photothèques (Immich,
   Synology Photos). Variables : form (champ media), immich et synology (connexions ou null), immich_albums,
   synology_albums, drop_label, drop_hint #}
{% import '_macros.html.twig' as ui %}
{% if immich or synology %}
    <div class="src-tabs" role="tablist" aria-label="Source des médias">
        <button type="button" role="tab" class="on" aria-selected="true" data-compose-target="sourceTab" data-action="compose#source" data-compose-source-param="device">{{ ui.icon('upload', 'xs') }}Appareil</button>
        {% if immich %}<button type="button" role="tab" aria-selected="false" data-compose-target="sourceTab" data-action="compose#source" data-compose-source-param="immich">{{ ui.icon('album', 'xs') }}Immich</button>{% endif %}
        {% if synology %}<button type="button" role="tab" aria-selected="false" data-compose-target="sourceTab" data-action="compose#source" data-compose-source-param="synology">{{ ui.icon('album', 'xs') }}Synology Photos</button>{% endif %}
    </div>
{% endif %}
<div data-compose-target="deviceSource">
    <label class="drop" for="{{ form.media.vars.id }}" data-compose-target="drop">
        {{ ui.icon('image', 'big') }}
        <b>{{ drop_label }}</b>
        <span class="small">{{ drop_hint }}</span>
        <span class="btn pri">Choisir sur l’appareil</span>
    </label>
</div>
{% if immich %}
    <div class="imm-source" data-controller="library-preview" data-compose-target="librarySource" data-source-name="immich" data-library-url="{{ path('app_immich_library') }}" hidden>
        <p class="small">Photothèque Immich · touchez une photo pour la voir en grand, ou son rond pour la choisir.</p>
        <div class="row wrap imm-filters">
            <label class="sr-only" for="immich-album">Album</label>
            <select id="immich-album" class="inp sm grow" data-library-album data-action="change->compose#filterLibrary">
                <option value="">Toutes les photos et vidéos</option>
                {% for album in immich_albums %}<option value="{{ album.id }}">{{ album.name }} ({{ album.count }})</option>{% endfor %}
            </select>
            {# Aller à une date : seulement pour toute la photothèque, pas dans un album. #}
            <span class="row imm-date" data-library-without-album>
                <label class="row"><span class="small">Aller au</span>
                    <input type="date" class="inp sm" max="{{ 'now'|date('Y-m-d') }}" data-library-date data-action="change->compose#filterLibrary" aria-label="Aller directement à une date">
                </label>
                <button type="button" class="btn sm ghost" data-action="compose#resetLibrary" title="Revenir aux plus récentes">Plus récentes</button>
            </span>
        </div>
        <div class="imm-scroll">
            <turbo-frame id="immich-library" src="{{ path('app_immich_library') }}" loading="lazy"><p class="small">Chargement de la photothèque…</p></turbo-frame>
        </div>
    </div>
{% endif %}
{% if synology %}
    <div class="imm-source" data-controller="library-preview" data-compose-target="librarySource" data-source-name="synology" data-library-url="{{ path('app_synology_photos_library') }}" hidden>
        <p class="small">Synology Photos · touchez une photo pour la voir en grand, ou son rond pour la choisir.</p>
        <div class="row wrap imm-filters">
            <label class="sr-only" for="synology-album">Album</label>
            <select id="synology-album" class="inp sm grow" data-library-album data-action="change->compose#filterLibrary">
                <option value="">Toutes les photos et vidéos</option>
                {% for album in synology_albums %}<option value="{{ album.id }}">{{ album.name }} ({{ album.count }})</option>{% endfor %}
            </select>
            {# Espace et date : seulement pour toute la photothèque, pas dans un album. #}
            <span class="row" data-library-without-album>
                <label class="sr-only" for="synology-space">Espace</label>
                <select id="synology-space" class="inp sm" data-library-space data-action="change->compose#filterLibrary">
                    <option value="p">Espace personnel</option>
                    <option value="t">Espace partagé</option>
                </select>
            </span>
            <span class="row imm-date" data-library-without-album>
                <label class="row"><span class="small">Aller au</span>
                    <input type="date" class="inp sm" max="{{ 'now'|date('Y-m-d') }}" data-library-date data-action="change->compose#filterLibrary" aria-label="Aller directement à une date">
                </label>
                <button type="button" class="btn sm ghost" data-action="compose#resetLibrary" title="Revenir aux plus récentes">Plus récentes</button>
            </span>
        </div>
        <div class="imm-scroll">
            <turbo-frame id="synology-library" src="{{ path('app_synology_photos_library') }}" loading="lazy"><p class="small">Chargement de la photothèque…</p></turbo-frame>
        </div>
    </div>
{% endif %}
