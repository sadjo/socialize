{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}Nouvelle publication · Socialize{% endblock %}

{% block content %}
<div class="compose">
    <div class="page-h"><div class="grow"><h1>Nouvelle publication</h1><p>Jusqu’à 20 photos ou vidéos. Les originaux et leurs métadonnées sont conservés ; les copies publiques ne contiennent pas votre position GPS.</p></div></div>

    {{ form_start(form, {attr: {class: 'form', 'data-controller': 'compose', 'data-compose-max-value': 20, 'data-compose-alt-name-value': 'compose_post[altTexts][__key__]'}}) }}
        {{ form_errors(form) }}
        <div class="compose-grid">
            <section class="card picker">
                <label class="drop" for="{{ form.media.vars.id }}" data-compose-target="drop">
                    {{ ui.icon('image', 'big') }}
                    <b>Choisissez vos photos et vidéos</b>
                    <span class="small">JPEG, HEIC, PNG, WebP, AVIF, MP4, MOV, WebM · 50 Mo par photo, 500 Mo par vidéo</span>
                    <span class="btn pri">Choisir sur l’appareil</span>
                </label>
                {{ form_widget(form.media) }}
                {{ form_errors(form.media) }}
                <p class="small">Chaque nouvelle sélection s’ajoute aux médias déjà choisis. Faites glisser les aperçus, ou utilisez ◀ ▶, pour changer l’ordre.</p>
                <div class="previews" data-compose-target="previews" aria-live="polite"></div>
                {% do form.altTexts.setRendered %}
            </section>

            <section class="card">
                {{ form_row(form.caption) }}
                <div class="counter num" data-compose-target="counter">0 / 2 200</div>
                {{ form_row(form.location) }}
                <fieldset class="field" style="border:0;padding:0;margin:0">
                    <legend class="lab" style="margin-bottom:6px">Visibilité</legend>
                    <div class="choices">
                        {% for choice in form.visibility %}
                            {{ form_widget(choice) }}
                            <label for="{{ choice.vars.id }}">{{ choice.vars.label }}<small>{{ choice.vars.value == 'public' ? 'Fils publics et fédivers' : choice.vars.value == 'unlisted' ? 'Visible avec le lien' : choice.vars.value == 'followers' ? 'Vos abonnés' : 'Vous seulement' }}</small></label>
                        {% endfor %}
                    </div>
                </fieldset>
                {{ form_row(form.contentWarning) }}
                <button class="btn pri" data-compose-target="submit">Publier</button>
            </section>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
