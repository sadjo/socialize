{# Sélecteur de musique libre (Openverse) : recherche, pré-écoute relayée, choix d'un morceau, début de l'extrait.
   Le morceau est copié sur l'instance à la publication. Variables : field (champ music du formulaire) #}
{% import '_macros.html.twig' as ui %}
{% set excerpt = constant('App\\Core\\Domain\\Music\\MusicChoice::EXCERPT') %}
{% set track_id = field.track.vars.value %}
{% set current = music_choice(track_id) %}
{% set current_start = field.start.vars.value ?: 0 %}
<fieldset class="field music-picker" data-controller="music-picker"
          data-music-picker-search-url-value="{{ path('app_music_search') }}"
          data-music-picker-listen-url-value="{{ path('app_music_listen', {openverseId: '00000000-0000-0000-0000-000000000000'}) }}"
          data-music-picker-excerpt-value="{{ excerpt }}">
    <legend class="lab">{{ ui.icon('music', 'xs') }} Musique</legend>
    {{ form_widget(field.track) }}
    {{ form_widget(field.start) }}

    <div class="music-chosen" data-music-picker-target="chosen"{% if not current %} hidden{% endif %}>
        <div class="row">
            <button type="button" class="ib music-play" data-action="music-picker#togglePreview" data-music-picker-target="play" aria-label="Écouter l’extrait">{{ ui.icon('play', 'sm') }}</button>
            <div class="grow">
                <b data-music-picker-target="title">{{ current ? current.title }}</b>
                <div class="small" data-music-picker-target="credit">{{ current ? current.artist ~ ' · ' ~ current.license }}</div>
            </div>
            <button type="button" class="btn sm ghost" data-action="music-picker#remove">Retirer</button>
        </div>
        <label class="music-start">
            <span class="small">Extrait : <b class="num" data-music-picker-target="startLabel">0:00</b></span>
            <input type="range" min="0" step="1" value="{{ current_start }}" max="{{ current ? max(0, current.duration - excerpt) : 0 }}"
                   data-music-picker-target="range" data-action="input->music-picker#seek change->music-picker#seek" aria-label="Début de l’extrait">
        </label>
        <audio preload="none" data-music-picker-target="audio"{% if current %} src="{{ path('app_music_listen', {openverseId: track_id}) }}"{% endif %}></audio>
    </div>

    <div class="music-search" data-music-picker-target="searchBox"{% if current %} hidden{% endif %}>
        <div class="row">
            <label class="sr-only" for="{{ field.vars.id }}_q">Rechercher une musique</label>
            <input type="search" id="{{ field.vars.id }}_q" class="inp grow" placeholder="Ambiance, genre, artiste… (en anglais : chill, piano, rock)" maxlength="100"
                   data-music-picker-target="query" data-action="keydown.enter->music-picker#search:prevent">
            <button type="button" class="btn" data-action="music-picker#search">{{ ui.icon('search', 'xs') }}Chercher</button>
        </div>
        <p class="small">Musiques sous licence libre trouvées par <a href="https://openverse.org" target="_blank" rel="noopener">Openverse</a>. Le titre, l’artiste et la licence sont affichés avec la publication.</p>
        <div class="music-results" data-music-picker-target="results" aria-live="polite"></div>
    </div>
    <p class="field-errors" data-music-picker-target="error" hidden></p>
</fieldset>
