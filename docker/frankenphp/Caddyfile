{
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
		# Ne jamais journaliser les jetons d'accès.
		format filter {
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>uri query {
				replace access_token REDACTED
			}
		}
	}

	root /app/public
	encode zstd br gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "browsing-topics=(), interest-cohort=()"
		-Server
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Copies publiques des médias (WebP, MP4, affiches), servies directement depuis le volume.
	# Les originaux, dans STORAGE_DIR/originals, ne sont jamais exposés.
	handle_path /m/* {
		root * {$STORAGE_DIR:/media}/public
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	# Assets compilés par AssetMapper : leur nom contient une empreinte du contenu, ils peuvent être gardés un an
	# sans être revalidés au lancement de l'application. Seulement les fichiers existants (pas une 404 de Symfony).
	@assets {
		path /assets/*
		file
	}
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Les fichiers existants (assets compilés) sont servis directement,
	# tout le reste passe par le contrôleur frontal Symfony.
	@phpRoute {
		not path /m/*
		not file {path}
	}
	rewrite @phpRoute index.php

	@frontController path index.php
	php @frontController

	# Manifeste de l'application (icône de l'écran d'accueil sur Android) : son type n'est pas connu de Caddy.
	@manifest path /site.webmanifest
	header @manifest Content-Type "application/manifest+json"

	file_server {
		hide *.php
	}
}
