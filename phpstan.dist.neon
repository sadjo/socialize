parameters:
    level: max
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        - config/reference.php
    tmpDir: var/cache/phpstan
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
        consoleApplicationLoader: tests/console-application.php
    doctrine:
        objectManagerLoader: tests/object-manager.php
    ignoreErrors:
        # La fausse instance du fédivers n'existe que dans le conteneur de test.
        -
            message: '#Service "App\\Tests\\Federation\\FakeFediverse" is not registered in the container#'
            path: tests/Federation/FederationTest.php
