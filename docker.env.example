# Configuration du conteneur Socialize.
# Copiez ce fichier en docker.env (ignoré par git) puis adaptez les valeurs.

# Domaine public. Caddy obtient automatiquement un certificat HTTPS.
# Derrière un reverse proxy qui gère déjà le HTTPS (Traefik, Nginx, Caddy…), utilisez ":80".
SERVER_NAME=photos.example.org

# Obligatoire. Générez une valeur avec : openssl rand -hex 32
APP_SECRET=

# URL publique, utilisée pour générer les liens hors requête HTTP (tâches de fond, fédération).
DEFAULT_URI=https://photos.example.org

# Base de données : SQLite dans le volume /data par défaut.
# DATABASE_URL=sqlite:////data/socialize.db
# DATABASE_URL=mysql://socialize:motdepasse@hote:3306/socialize?serverVersion=11.4.0-MariaDB&charset=utf8mb4

# Qui peut créer un compte : open, invite (seul le premier compte, administrateur) ou closed (aucun ;
# créez l'administrateur avec : php bin/console app:user:create email nom --admin).
REGISTRATION=invite

# Connexion avec un compte Mastodon : closed (personne), open (tout serveur) ou la liste des serveurs permis,
# séparés par des virgules (mastodon.social,piaille.fr).
MASTODON_LOGIN=closed

# Nombre de consommateurs Messenger lancés dans le conteneur (0 pour aucun).
WORKERS=1

# Proxies de confiance quand Socialize est derrière un reverse proxy.
# TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
